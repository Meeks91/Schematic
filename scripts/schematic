# ── constants ──────────────────────────────────────────────────────────────────

# One task as parsed out of tasks.md: tag, action, target, status, component_file, blocked_by, raw_lines.
TaskRecord: TypeAlias = dict[str, Any]

SCHEMATICS_BASE = "docs/schematics"
STANDARDS_MANIFEST_RELPATH_CANONICAL = ".schematic/standards.json"
STANDARDS_MANIFEST_RELPATH = ".claude/standards.json"
ARCHIVE_SUBDIR = "_archive"
STATE_FILENAME = ".schematic-state.json"

TASK_STATUS_PENDING = "pending"
TASK_STATUS_IN_PROGRESS = "in_progress"
TASK_STATUS_PENDING_INPUT = "pendingInput"
TASK_STATUS_REVIEW = "review"
TASK_STATUS_COMPLETE = "complete"
VALID_TASK_STATUSES = {
    TASK_STATUS_PENDING,
    TASK_STATUS_IN_PROGRESS,
    TASK_STATUS_PENDING_INPUT,
    TASK_STATUS_REVIEW,
    TASK_STATUS_COMPLETE,
}
# pendingInput is entered only by `task ask`, which files the question that holds the task.
MANUAL_TASK_STATUS_CHOICES = sorted(VALID_TASK_STATUSES - {TASK_STATUS_PENDING_INPUT})
TASK_STATUSES_ALLOWED_TO_ASK = {
