def _print_slot_paths(slot_label: str, module_paths: list[Path]) -> None:
    """Print one line per resolved module, labelling only the first."""
    for position, module_path in enumerate(module_paths):
        label = f"{slot_label}:" if position == 0 else ""
        print(f"  {label:<13} {module_path}")


def _print_model_config(project_root: Path) -> None:
    """Print which model runs the diff review and which runs the Pass-3 correctness read."""
    correctness_model = _resolve_correctness_model(project_root)
    print(f"  {'reviewModel:':<18} {_resolve_review_model(project_root)}")
    print(f"  {'correctnessModel:':<18} {correctness_model or CORRECTNESS_MODEL_INHERIT_LABEL}")


def _report_standards_manifest(project_root: Path) -> None:
    """Slot-by-slot manifest coverage — the onboarding cue for Phase 0."""
    manifest_path = _locate_standards_manifest(project_root)

    if manifest_path is None:
        print("standards: NO MANIFEST FOUND")
        print("  Phase 0 onboards you (standards_resolution.md):")
        print("    1. map slots to skills you already have (architecture/types/styling/testing/review), or")
        print("    2. LEARN — derive each unmapped slot from your codebase's exemplar directories.")
        print("  These modules feed every stage: topology + contracts (plan), sketches (implement),")
        print("  diff sweeps + audits (review). Run Phase 0 before Phase 1.")
        return

    source_label = (
        f"{manifest_path.relative_to(project_root)} (repo manifest)"
        if manifest_path.is_relative_to(project_root)
        else f"{manifest_path} (global default — Phase 0 confirms + copies it into the repo)"
    )
    print(f"standards: {source_label}")

    manifest = _load_standards_manifest(project_root)
    slot_paths = _resolved_slot_paths(project_root)
    unmapped: list[str] = []
    for slot in STANDARDS_SLOTS:
        if slot == EXEMPLARS_SLOT:
            exemplars = manifest.get(EXEMPLARS_SLOT, [])
            status = ", ".join(exemplars) if exemplars else "—"
            print(f"  exemplars:    {status}")
            continue
        if slot == STYLING_SLOT:
            styling_slot_to_paths = {
                slot_label: paths
                for slot_label, paths in slot_paths.items()
                if slot_label.startswith("styling.")
            }
            if styling_slot_to_paths:
                for lang_slot, paths in sorted(styling_slot_to_paths.items()):
                    _print_slot_paths(slot_label=lang_slot, module_paths=paths)
            else:
                unmapped.append(STYLING_SLOT)
                print("  styling:      UNMAPPED")
            continue
        if slot in slot_paths:
            _print_slot_paths(slot_label=slot, module_paths=slot_paths[slot])
        else:
            unmapped.append(slot)
            print(f"  {slot + ':':<13} UNMAPPED")

    _print_model_config(project_root=project_root)
    if unmapped:
        print(f"  → Phase 0 resolves unmapped slots ({', '.join(unmapped)}): map an existing")
        print("    module or LEARN it from the codebase (standards_resolution.md → Learn mode).")


_ANSI_CYAN = "\033[36m"
_ANSI_BOLD = "\033[1m"
_ANSI_DIM = "\033[2m"
_ANSI_RESET = "\033[0m"
_BANNER_LINE_DELAY_SECONDS = 0.05
_BANNER_TICK_DELAY_SECONDS = 0.04


def _print_init_banner(feature_name: str) -> None:
    """Blueprint-style intro. Animated on a TTY; plain single print otherwise."""
    is_tty = sys.stdout.isatty()
    cyan, bold, dim, reset = (
        (_ANSI_CYAN, _ANSI_BOLD, _ANSI_DIM, _ANSI_RESET) if is_tty else ("", "", "", "")
    )
    banner_lines = [
        f"{cyan}███████╗ ██████╗██╗  ██╗███████╗███╗   ███╗ █████╗ ████████╗██╗ ██████╗{reset}",
        f"{cyan}██╔════╝██╔════╝██║  ██║██╔════╝████╗ ████║██╔══██╗╚══██╔══╝██║██╔════╝{reset}",
        f"{cyan}███████╗██║     ███████║█████╗  ██╔████╔██║███████║   ██║   ██║██║{reset}",
        f"{cyan}╚════██║██║     ██╔══██║██╔══╝  ██║╚██╔╝██║██╔══██║   ██║   ██║██║{reset}",
        f"{cyan}███████║╚██████╗██║  ██║███████╗██║ ╚═╝ ██║██║  ██║   ██║   ██║╚██████╗{reset}",
        f"{cyan}╚══════╝ ╚═════╝╚═╝  ╚═╝╚══════╝╚═╝     ╚═╝╚═╝  ╚═╝   ╚═╝   ╚═╝ ╚═════╝{reset}",
        "",
        f"        {dim}t h e   d e s i g n   i s   t h e   c o n t r a c t{reset}",
        "",
        f" {dim}spec ─▶ topology ─▶ contracts ─▶ DAG ─▶ sequence ─▶ tasks ─▶ build ─▶ compress{reset}",
        f" {dim}└────────────────── audit ▸ sign-off ▸ lock at every gate ───────────────────┘{reset}",
        "",
        f"  {bold}drafting:{reset} {feature_name}",
        "",
    ]
    for line in banner_lines:
        print(line, flush=True)
        if is_tty:
            time.sleep(_BANNER_LINE_DELAY_SECONDS)


def cmd_init(args: argparse.Namespace) -> None:
    root = find_project_root()
    schematic_dir = root / SCHEMATICS_BASE / args.name
    if schematic_dir.exists():
        _exit_error(f"schematic '{args.name}' already exists at {schematic_dir}")

    _print_init_banner(args.name)

    components_dir = schematic_dir / "components"
    components_dir.mkdir(parents=True)
    research_dir = schematic_dir / "research"
    research_dir.mkdir(parents=True)

    (schematic_dir / "objective.md").write_text(_OBJECTIVE_STUB.format(name=args.name))
    (schematic_dir / "tasks.md").write_text(_TASKS_STUB)
    (schematic_dir / "dag.mmd").write_text(_DAG_STUB)
    (schematic_dir / "sequence.mmd").write_text(_SEQUENCE_STUB)
    (components_dir / "_overview.md").write_text(_OVERVIEW_STUB)
    save_state(schematic_dir, {"feature": args.name, "phases": {}, "tasks": {}, "overrides": []})

    is_tty = sys.stdout.isatty()
    print(f"created: {schematic_dir.relative_to(root)}")
    for name in ["objective.md", "tasks.md", "dag.mmd", "sequence.mmd",
                 "components/_overview.md", "research/", STATE_FILENAME]:
        print(f"  ✏︎ {name}", flush=True)
        if is_tty:
            time.sleep(_BANNER_TICK_DELAY_SECONDS)
    print()
    _report_standards_manifest(project_root=root)

# ── status command ─────────────────────────────────────────────────────────────

def cmd_status(args: argparse.Namespace) -> None:
    for schematic_dir in _resolve_single_or_all(args.name):
        _print_status(schematic_dir)
        print()


def _print_status(schematic_dir: Path) -> None:
    state = load_state(schematic_dir)
    tasks = parse_tasks(schematic_dir / "tasks.md")

    locked_phases = sorted(int(k) for k, v in state["phases"].items() if v.get("status") == PHASE_STATUS_LOCKED)
    highest_locked = max(locked_phases, default=0)
    all_phases_locked = highest_locked >= FINAL_PHASE
    current_phase = min(highest_locked + 1, FINAL_PHASE)
    phase_label = "complete" if all_phases_locked else f"{current_phase}/{FINAL_PHASE}"
    locked_line = "  ".join(f"P{n} ✓" for n in locked_phases) if locked_phases else "—"

    by_status: dict[str, list[str]] = {
        TASK_STATUS_COMPLETE: [],
        TASK_STATUS_IN_PROGRESS: [],
        TASK_STATUS_PENDING_INPUT: [],
        TASK_STATUS_PENDING: [],
    }
    complete_tags = {t["tag"] for t in tasks if t["status"] == TASK_STATUS_COMPLETE}
    blocked_summaries: list[str] = []

    for task in tasks:
        bucket = by_status.get(task["status"], by_status[TASK_STATUS_PENDING])
        bucket.append(task["tag"])
        if task["status"] == TASK_STATUS_PENDING and task["blocked_by"]:
            active_blockers = [b for b in task["blocked_by"] if b not in complete_tags]
            if active_blockers:
                blocked_summaries.append(f"{task['tag']} ← {', '.join(active_blockers)}")

    print(f"schematic: {schematic_dir.name}")
    print(f"phase:     {phase_label}")
    print(f"locked:    {locked_line}")
    if state.get("overrides"):
        print(f"overrides: {len(state['overrides'])} (run validate to review)")

    total = len(tasks)
    print(f"\ntasks: {total} total")
    for status_key in [
        TASK_STATUS_COMPLETE,
        TASK_STATUS_IN_PROGRESS,
        TASK_STATUS_PENDING_INPUT,
        TASK_STATUS_PENDING,
    ]:
        tags = by_status[status_key]
        if tags:
            print(f"  {status_key:<12} {len(tags):>2}  [{', '.join(tags)}]")

    if blocked_summaries:
        print("\nblocked:")
        for entry in blocked_summaries:
            print(f"  {entry}")

# ── validate command ───────────────────────────────────────────────────────────

def cmd_validate(args: argparse.Namespace) -> None:
    findings: list[str] = []
    for schematic_dir in _resolve_single_or_all(args.name):
        scoped = _validate_schematic(schematic_dir)
        findings.extend(f"[{schematic_dir.name}] {f}" for f in scoped)

    if findings:
        print(f"⚠️  {len(findings)} finding(s):\n")
        for i, finding in enumerate(findings, 1):
            print(f"  {i}. {finding}")
        sys.exit(1)
    else:
        print("✓ validate: clean")


def _component_file_owners(tasks: list[TaskRecord]) -> dict[str, set[str]]:
    """Bundle-relative markdown path → the task tags that own it (tasks.md is owned by all)."""
    path_to_tags: dict[str, set[str]] = {"tasks.md": {task["tag"] for task in tasks}}
    for task in tasks:
        if task["component_file"]:
            path_to_tags.setdefault(task["component_file"].lstrip("./"), set()).add(task["tag"])
    return path_to_tags


def _lintable_markdown_paths(schematic_dir: Path) -> list[Path]:
    """The ledgers and component cards the ratification lint reads."""
    ledger_paths = [
        schematic_dir / filename
        for filename in LINT_LEDGER_FILENAMES
        if (schematic_dir / filename).exists()
    ]
    return ledger_paths + sorted((schematic_dir / "components").glob("*.md"))


def _ratification_phrase_findings(schematic_dir: Path, tasks: list[TaskRecord]) -> list[str]:
    """Cards and ledgers claiming something awaits sign-off, with no question filed to hold it."""
    # Only an OPEN question is a state. Once it is answered the prose is stale again.
    tags_awaiting_answer = {
        tag for tag in load_state(schematic_dir)["tasks"]
        if _unanswered_question_idxs(schematic_dir, tag)
    }
    path_to_owning_tags = _component_file_owners(tasks)

    findings: list[str] = []
    for markdown_path in _lintable_markdown_paths(schematic_dir):
        relative_name = markdown_path.relative_to(schematic_dir).as_posix()
        if path_to_owning_tags.get(relative_name, set()) & tags_awaiting_answer:
            continue
        for phrase in sorted(set(RATIFICATION_PHRASE_RE.findall(markdown_path.read_text()))):
            findings.append(
                f"{relative_name} — \"{phrase}\" is prose with no question behind it; "
                f"a note is not a state. File it: schematic task ask <tag> \"<question>\" "
                f"--schematic {schematic_dir.name}"
            )
    return findings


def _open_input_findings(schematic_dir: Path, tasks: list[TaskRecord]) -> list[str]:
    """Everything still waiting on the user: held tasks, unanswered questions, ratification prose."""
    findings = [
        f"tasks.md #{task['tag']} — held in '{TASK_STATUS_PENDING_INPUT}': "
        f"waiting on a user answer, so the phase cannot exit"
        for task in tasks
        if task["status"] == TASK_STATUS_PENDING_INPUT
    ]
    findings.extend(
        f"unanswered question {question['id']} — \"{question['text']}\""
        for question in _pending_questions(schematic_dir)
    )
    findings.extend(
        _ratification_phrase_findings(
            schematic_dir=schematic_dir,
            tasks=tasks,
        )
    )
    return findings


def _milestone_findings(
    schematic_dir: Path,
    state: dict,
    tasks: list[TaskRecord],
) -> list[str]:
    """Milestone table rules — enforced only after lock; `milestone propose` checks them before."""
    milestones = parse_milestones(schematic_dir / "tasks.md")
    if _milestone_table_is_lost(state=state, milestones=milestones):
        return [MILESTONE_TABLE_LOST_FINDING]
    if not _milestones_are_locked(state=state, milestones=milestones):
        return []
    return _milestone_table_findings(tasks=tasks, milestones=milestones)


def _validate_schematic(schematic_dir: Path) -> list[str]:
    findings: list[str] = []
    tasks = parse_tasks(schematic_dir / "tasks.md")
    all_task_tags = {t["tag"] for t in tasks}
    state = load_state(schematic_dir)

    for task in tasks:
        for blocker_tag in task["blocked_by"]:
            if blocker_tag not in all_task_tags:
                findings.append(
                    f"tasks.md #{task['tag']} — Blocked by: '{blocker_tag}' not found in task list"
                )

    for task in tasks:
        if task["component_file"]:
            component_path = schematic_dir / task["component_file"].lstrip("./")
            if not component_path.exists():
                findings.append(
                    f"tasks.md #{task['tag']} — Component file '{task['component_file']}' not found"
                )

    objective_md = schematic_dir / "objective.md"
    if objective_md.exists() and not parse_feature_acs(objective_md):
        findings.append("objective.md — no Feature ACs found in Functional ACs section")

    for task in tasks:
        state_task = state.get("tasks", {}).get(task["tag"])
        if state_task is not None:
            state_status = state_task.get("status", TASK_STATUS_PENDING)
            if state_status != task["status"]:
                findings.append(
                    f"state drift: task {task['tag']} is '{task['status']}' in tasks.md "
                    f"but '{state_status}' in {STATE_FILENAME}"
                )

    findings.extend(
        _open_input_findings(
            schematic_dir=schematic_dir,
            tasks=tasks,
        )
    )

    findings.extend(
        _milestone_findings(
            schematic_dir=schematic_dir,
            state=state,
            tasks=tasks,
        )
    )

    for override in state.get("overrides", []):
        findings.append(
            f"override recorded — {override['context']}: \"{override['reason']}\""
        )

    for mmd_file in sorted(schematic_dir.glob("*.mmd")):
        for mmd_finding in _validate_mermaid_file(mmd_file):
            findings.append(f"{mmd_file.name}: {mmd_finding}")

    return findings

# ── mermaid command ────────────────────────────────────────────────────────────

def cmd_mermaid(args: argparse.Namespace) -> None:
    if args.file and args.name:
        _exit_error("specify either name or --file, not both")

    if args.file:
        files = [args.file]
    elif args.name:
        schematic_dir = resolve_schematic_dir(args.name)
        files = sorted(schematic_dir.glob("*.mmd"))
    else:
        files = [f for d in list_schematic_dirs() for f in sorted(d.glob("*.mmd"))]

    if not files:
        print("no .mmd files found")
        return

    all_clean = True
    for mmd_file in files:
        file_findings = _validate_mermaid_file(mmd_file)
        if file_findings:
            all_clean = False
            print(f"⚠️  {mmd_file}")
            for finding in file_findings:
                print(f"   {finding}")
        else:
            print(f"✓  {mmd_file.name}")

    if not all_clean:
        sys.exit(1)


def _validate_mermaid_file(path: Path) -> list[str]:
    mmdc_result = _try_mmdc(path)
    if mmdc_result is not None:
        return mmdc_result
    return _heuristic_mermaid_check(path)


MMDC_INVOCATIONS = (
    ["mmdc"],
    ["npx", "--yes", "@mermaid-js/mermaid-cli"],
)
MMDC_TIMEOUT_SECONDS = 60


def _try_mmdc(path: Path) -> list[str] | None:
    for base_command in MMDC_INVOCATIONS:
        try:
            result = subprocess.run(
                [*base_command, "-i", str(path), "-o", "/dev/null"],
                capture_output=True,
                text=True,
                timeout=MMDC_TIMEOUT_SECONDS,
            )
        except (OSError, subprocess.TimeoutExpired):
            continue
        if result.returncode == 0:
            return []
        if "Parse error" in result.stderr:
            return [f"mmdc: {result.stderr.strip()}"]
    return None


def _heuristic_mermaid_check(path: Path) -> list[str]:
    content_lines = [
        line for line in path.read_text().splitlines()
        if line.strip() and not line.strip().startswith("%%")
    ]
    if not content_lines:
        return ["empty file"]

    first_line = content_lines[0].strip()

    if first_line == "sequenceDiagram":
        return _check_sequence_diagram(content_lines[1:])
    if re.match(r"^(flowchart|graph)\s+[TDLRBT]{1,2}$", first_line):
        return _check_flowchart(content_lines[1:])
    if MERMAID_UNCHECKED_TYPES_RE.match(first_line):
        return []
    return [
        f"unrecognised diagram type on line 1: '{first_line}' "
        "(expected 'sequenceDiagram' or 'flowchart TD')"
    ]


def _check_sequence_diagram(body_lines: list[str]) -> list[str]:
    findings: list[str] = []
    block_stack: list[tuple[str, int]] = []

    for lineno, raw_line in enumerate(body_lines, start=2):
        line = raw_line.strip()
        if not line or line.startswith("%%"):
            continue

        if ";" in line and not line.rstrip().endswith(";"):
            findings.append(
                f"line {lineno}: ';' inside text splits the statement "
                "(mermaid treats ';' as a separator — use '—' or ',')"
            )

        first_word = line.split()[0].lower()

        if first_word in SEQUENCE_OPENERS:
            block_stack.append((first_word, lineno))
            continue

        if first_word == "end":
            if not block_stack:
                findings.append(f"line {lineno}: 'end' with no open block")
            else:
                block_stack.pop()
            continue

        if first_word in ("participant", "actor", "activate", "deactivate", "autonumber"):
            continue

        if line.startswith("Note"):
            if not any(line.startswith(p) for p in VALID_NOTE_PREFIXES):
                findings.append(
                    f"line {lineno}: invalid Note syntax '{line[:50]}' "
                    "(use: Note over X: / Note left of X: / Note right of X:)"
                )

    for opener, open_lineno in block_stack:
        findings.append(f"unclosed '{opener}' block opened at line {open_lineno} — missing 'end'")

    return findings


def _check_flowchart(body_lines: list[str]) -> list[str]:
    findings: list[str] = []
    for lineno, raw_line in enumerate(body_lines, start=2):
        line = raw_line.strip()
        if not line or line.startswith("%%"):
            continue
        first_word = line.split()[0].lower()
        if first_word in FLOWCHART_SKIP_KEYWORDS:
            continue
        if re.match(r"^\w+\s+\w+\s*[\[\(\{]", line):
            findings.append(
                f"line {lineno}: node ID appears to contain spaces — quote it or use a single-word ID: '{line[:60]}'"
            )
    return findings

# ── setup command ─────────────────────────────────────────────────────────────

_HOOK_MARKER = "schematic-validate-hook"
_HOOK_COMMAND = (
    "python3 -c \""
    "import json,os,subprocess,pathlib;"
    "p=json.loads(os.environ.get('CLAUDE_TOOL_INPUT','{}')).get('file_path','');"
    "subprocess.run([str(pathlib.Path.home()/'.claude'/'scripts'/'schematic'),'validate'])"
    " if 'docs/schematics' in p else None"
    "\""
)
_SETTINGS_RELATIVE = Path(".claude") / "settings.json"


def cmd_setup(args: argparse.Namespace) -> None:
    project_root = find_project_root()
    settings_path = project_root / _SETTINGS_RELATIVE

    if _hook_already_installed(settings_path):
        print("schematic validate hook already installed ✓")
        return

    if not args.install:
        print("dry run — would write PostToolUse hook to:")
        print(f"  {settings_path}")
        print("\nhook triggers: schematic validate on any write to docs/schematics/")
        print("\nrun with --install to apply")
        return

    _write_hook(settings_path)
    print(f"installed: PostToolUse hook → {settings_path.relative_to(project_root)}")
    print("  triggers: schematic validate on any write to docs/schematics/")


def _hook_already_installed(settings_path: Path) -> bool:
    if not settings_path.exists():
        return False
    settings = json.loads(settings_path.read_text())
    for hook_group in settings.get("hooks", {}).get("PostToolUse", []):
        for hook in hook_group.get("hooks", []):
            if _HOOK_MARKER in hook.get("command", ""):
                return True
    return False


def _write_hook(settings_path: Path) -> None:
    settings_path.parent.mkdir(parents=True, exist_ok=True)
    settings = json.loads(settings_path.read_text()) if settings_path.exists() else {}
    hook_entry = {
        "matcher": "Write|Edit",
        "hooks": [{"type": "command", "command": f"# {_HOOK_MARKER}\n{_HOOK_COMMAND}"}],
    }
    settings.setdefault("hooks", {}).setdefault("PostToolUse", []).append(hook_entry)
    settings_path.write_text(json.dumps(settings, indent=2) + "\n")

# ── phase commands ─────────────────────────────────────────────────────────────

def cmd_phase(args: argparse.Namespace) -> None:
    phase_handlers = {
        "audit": _phase_audit,
        "sign-off": _phase_signoff,
        "complete": _phase_complete,
    }
    phase_handlers[args.phase_command](args)


def _phase_audit(args: argparse.Namespace) -> None:
    if args.num not in PHASES_REQUIRING_AUDIT:
        _exit_error(
            f"phase {args.num} does not require an audit "
            f"(audit-required phases: {sorted(PHASES_REQUIRING_AUDIT)})"
        )
    schematic_dir = resolve_schematic_dir(args.schematic)
    state = load_state(schematic_dir)
    phase_entry = state["phases"].setdefault(str(args.num), {})
    is_clean = args.result.strip().lower() == PHASE_AUDIT_CLEAN
    phase_entry["audit_result"] = PHASE_AUDIT_CLEAN if is_clean else "findings"
    phase_entry["audit_findings"] = None if is_clean else args.result
    save_state(schematic_dir, state)
    label = "clean ✓" if is_clean else "findings recorded"
    print(f"phase {args.num} audit: {label}")
    print(f"next: schematic phase sign-off {args.num} --schematic {args.schematic}")


def _phase_signoff(args: argparse.Namespace) -> None:
    schematic_dir = resolve_schematic_dir(args.schematic)
    state = load_state(schematic_dir)
    phase_entry = state["phases"].setdefault(str(args.num), {})
    if args.num == ROSTER_PHASE and not phase_entry.get("roster"):
        _exit_error(
            "phase 2 sign-off blocked — the roster editor was never launched.\n"
            f"  run: schematic roster init {ROSTER_PHASE} --schematic {args.schematic} "
            "(opens the editor), fill the canvas, then sign off.",
        )
    phase_entry["signed_off"] = True
    save_state(schematic_dir, state)
    print(f"phase {args.num} signed off ✓")
    print(f"next: schematic phase complete {args.num} --schematic {args.schematic}")


def _phase_complete(args: argparse.Namespace) -> None:
    schematic_dir = resolve_schematic_dir(args.schematic)
    state = load_state(schematic_dir)
    phase_entry = state["phases"].setdefault(str(args.num), {})
    context = f"phase complete {args.num}"

    if args.num in PHASES_REQUIRING_AUDIT and not phase_entry.get("audit_result"):
        if args.override:
            record_override(state, context, args.override)
        else:
            _exit_error(
                f"phase {args.num} requires an audit result before locking.\n"
                f"  run: schematic phase audit {args.num} clean --schematic {args.schematic}\n"
                f"  or:  schematic phase complete {args.num} --schematic {args.schematic} "
                f"--override \"<reason>\""
            )

    if not phase_entry.get("signed_off"):
        if args.override:
            record_override(state, context, args.override)
        else:
            _exit_error(
                f"phase {args.num} requires user sign-off before locking.\n"
                f"  run: schematic phase sign-off {args.num} --schematic {args.schematic}\n"
                f"  or:  schematic phase complete {args.num} --schematic {args.schematic} "
                f"--override \"<reason>\""
            )

    milestone_refusal = _milestone_phase_refusal(
        schematic_dir=schematic_dir,
        num=args.num,
        schematic_name=args.schematic,
    )
    if milestone_refusal:
        if args.override:
            record_override(state, context, args.override)
        else:
            _exit_error(milestone_refusal)

    for rel_path, heading in PHASE_ARTIFACT_CHECKS.get(args.num, []):
        target = schematic_dir / rel_path
        content = target.read_text() if target.exists() else ""
        check_failed = not content if not heading else heading not in content
        if check_failed:
            if args.override:
                record_override(state, context, args.override)
                break
            else:
                reason = f"'{rel_path}' must exist and be non-empty" if not heading else f"'{rel_path}' must contain '{heading}'"
                _exit_error(
                    f"phase {args.num} artifact check failed: "
                    f"{reason}.\n"
                    f"  Write the artifact to disk before locking.\n"
                    f"  or:  schematic phase complete {args.num} --schematic {args.schematic} "
                    f"--override \"<reason>\""
                )

    for mmd_name in PHASE_MERMAID_CHECKS.get(args.num, []):
        mmd_path = schematic_dir / mmd_name
        mermaid_findings = _validate_mermaid_file(mmd_path) if mmd_path.exists() else [f"{mmd_name} missing"]
        if mermaid_findings:
            if args.override:
                record_override(state, context, args.override)
                break
            findings_text = "\n".join(f"    {finding}" for finding in mermaid_findings)
            _exit_error(
                f"phase {args.num} mermaid check failed — {mmd_name} does not validate:\n"
                f"{findings_text}\n"
                f"  fix the diagram (schematic mermaid --file {mmd_path}), then re-lock.\n"
                f"  or:  schematic phase complete {args.num} --schematic {args.schematic} "
                f"--override \"<reason>\""
            )

    state["phases"].setdefault(str(args.num), {})["status"] = PHASE_STATUS_LOCKED
    save_state(schematic_dir, state)
    print(f"phase {args.num} locked ✓")
    if args.num < PLANNING_FINAL_PHASE:
        print(f"next phase: {args.num + 1}")
    elif args.num == PLANNING_FINAL_PHASE:
        print(f"planning complete — next: schematic review start --schematic {args.schematic}  (Phase 8)")
    elif args.num == IMPLEMENTATION_PHASE:
        print("next phase: 9 (compression — lock BEFORE deleting the schematic dir)")
    else:
        print("schematic complete ✓ — bundle compressed into repo docs")

    if args.num == IMPLEMENTATION_PHASE:
        # The build is done: hand the user the whole dashboard, not a terminal tail.
        _present_finished_dashboard(schematic_dir=schematic_dir)

# ── task commands ──────────────────────────────────────────────────────────────

def cmd_task(args: argparse.Namespace) -> None:
    task_handlers = {
        "show": _task_show,
        "status": _task_status,
        "complete": _task_complete,
        "next": _task_next,
        "note": _task_note,
        "ask": _task_ask,
        "decision": _task_decision,
        "review-result": _task_review_result,
    }
    task_handlers[args.task_command](args)


def _file_task_question(schematic_dir: Path, tag: str, question: str) -> int:
    """Append a task question to the shared Q&A relay; returns its relay index."""
    questions_path = schematic_dir / f"{TASK_QUESTIONS_STEM}{QUESTIONS_SUFFIX}"
    questions = _load_json_list(questions_path)
    question_idx = len(questions)
    questions.append({
        "idx": question_idx,
        "tag": tag,
        "text": question,
        "context": f"task {tag}",
    })
    questions_path.write_text(json.dumps(questions, indent=2) + "\n")
    return question_idx


def _hold_task_on_question(schematic_dir: Path, tag: str, question: str) -> int:
    """File the question, move the task to pendingInput, and record what is holding it."""
    question_idx = _file_task_question(
        schematic_dir=schematic_dir,
        tag=tag,
        question=question,
    )
    update_task_status_in_file(
        tasks_md=schematic_dir / "tasks.md",
        tag=tag,
        new_status=TASK_STATUS_PENDING_INPUT,
    )

    state = load_state(schematic_dir)
    task_state = state["tasks"].setdefault(tag, {})
    task_state["status"] = TASK_STATUS_PENDING_INPUT
    task_state.setdefault("questions", []).append({
        "idx": question_idx,
        "text": question,
        "asked_at": datetime.now(tz=timezone.utc).isoformat(),
    })
    save_state(schematic_dir, state)
    return question_idx


def _unanswered_question_idxs(schematic_dir: Path, tag: str) -> list[int]:
    """Relay indices of questions filed for this task that the user has not answered."""
    filed_questions = load_state(schematic_dir)["tasks"].get(tag, {}).get("questions", [])
    answered_idxs = {
        answer.get("idx")
        for answer in _load_json_list(schematic_dir / f"{TASK_QUESTIONS_STEM}{ANSWERS_SUFFIX}")
    }
    return [
        question["idx"]
        for question in filed_questions
        if question["idx"] not in answered_idxs
    ]


def _print_held_task(
    schematic_name: str,
    tag: str,
    previous_status: str,
    question_idx: int,
    question: str,
) -> None:
    """Announce the hold and the one command that lifts it."""
    question_id = f"{TASK_QUESTIONS_STEM}#{question_idx}"
    print(f"task {tag}: {previous_status} → {TASK_STATUS_PENDING_INPUT}")
    print(f"  {question_id}: {question}")
    print(f"  HELD until answered: schematic answer {question_id} \"<text>\" {schematic_name}")
    print("  do not proceed on this task, and do not record the gap as a note.")


def _task_ask(args: argparse.Namespace) -> None:
    """File a question against a task and hold it in pendingInput until the user answers."""
    schematic_dir = resolve_schematic_dir(args.schematic)
    tasks_md = schematic_dir / "tasks.md"
    task = next((t for t in parse_tasks(tasks_md) if t["tag"] == args.tag), None)
    if not task:
        _exit_error(f"task '{args.tag}' not found in {tasks_md}")

    current_status = task["status"]
    if current_status not in TASK_STATUSES_ALLOWED_TO_ASK:
        _exit_error(
            f"task {args.tag} is '{current_status}' — only a claimed task can ask a question\n"
            f"  claim it first: schematic task next {schematic_dir.name}"
        )

    _print_held_task(
        schematic_name=schematic_dir.name,
        tag=args.tag,
        previous_status=current_status,
        question_idx=_hold_task_on_question(
            schematic_dir=schematic_dir,
            tag=args.tag,
            question=args.text,
        ),
        question=args.text,
    )


def _task_show(args: argparse.Namespace) -> None:
    schematic_dir = resolve_schematic_dir(args.schematic)
    tasks = parse_tasks(schematic_dir / "tasks.md")
    task = next((t for t in tasks if t["tag"] == args.tag), None)
    if not task:
        _exit_error(f"task '{args.tag}' not found in {schematic_dir / 'tasks.md'}")

    print("\n".join(task["raw_lines"]))

    if task["component_file"]:
        component_path = schematic_dir / task["component_file"].lstrip("./")
        if component_path.exists():
            print(f"\n--- {component_path.name} ---\n")
            print(component_path.read_text())
        else:
            print(f"\nwarning: component file not found: {component_path}", file=sys.stderr)


def _task_status(args: argparse.Namespace) -> None:
    schematic_dir = resolve_schematic_dir(args.schematic)
    tasks_md = schematic_dir / "tasks.md"
    tasks = parse_tasks(tasks_md)
    task = next((t for t in tasks if t["tag"] == args.tag), None)
    if not task:
        _exit_error(f"task '{args.tag}' not found in tasks.md")

    current_status = task["status"]
    new_status = args.status
    legal_targets = LEGAL_TASK_TRANSITIONS.get(current_status, set())

    if new_status == TASK_STATUS_REVIEW and _unanswered_question_idxs(schematic_dir, args.tag):
        _exit_error(
            f"task {args.tag} cannot be submitted for review — it has unanswered question(s).\n"
            f"  A task is ship-ready only with zero open questions.\n"
            f"  see:    schematic questions {schematic_dir.name}\n"
            f"  answer: schematic answer {TASK_QUESTIONS_STEM}#<idx> \"<text>\" {schematic_dir.name}"
        )

    if new_status not in legal_targets:
        if args.override:
            state = load_state(schematic_dir)
            record_override(
                state,
                f"task status {args.tag}: {current_status} → {new_status}",
                args.override,
            )
            save_state(schematic_dir, state)
        else:
            _exit_error(
                f"illegal transition: '{current_status}' → '{new_status}' for task {args.tag}\n"
                f"  legal from '{current_status}': {sorted(legal_targets) or 'none'}\n"
                f"  use --override \"<reason>\" to bypass"
            )

    update_task_status_in_file(tasks_md, args.tag, new_status)
    state = load_state(schematic_dir)
    state["tasks"].setdefault(args.tag, {})["status"] = new_status
    save_state(schematic_dir, state)
    print(f"task {args.tag}: {current_status} → {new_status}")

    if new_status == TASK_STATUS_REVIEW:
        review_request = {
            "tag": args.tag,
            "target": task.get("target", "unknown"),
            "component_file": task.get("component_file"),
            "requested_at": datetime.now(tz=timezone.utc).isoformat(),
            "status": "pending",
        }
        state["tasks"].setdefault(args.tag, {})["review_request"] = review_request
        save_state(schematic_dir, state)
        print(f"\n⚡ REVIEW REQUESTED for {args.tag}")
        print(f"  Target: {task.get('target', 'unknown')}")
        _emit_review_request(schematic_dir, args.tag, task)


def _emit_review_request(schematic_dir: Path, tag: str, task: dict) -> None:
    """Print the review prompt for the session agent to dispatch as a subagent."""
    project_root = find_project_root()
    review_model = _resolve_review_model(project_root)
    target = task.get("target", "unknown")
    component_spec = task.get("component_file") or "the task's component spec"

    slot_paths = _resolved_slot_paths(project_root)
    if slot_paths:
        module_lines = "\n".join(
            f"     - {slot}: {path}"
            for slot, paths in sorted(slot_paths.items())
            for path in paths
        )
        lens_block = (
            f"PRIMARY lens — read the resolved standards modules below, then verify the\n"
            f"changed lines against them (plus the project's CLAUDE.md, which\n"
            f"overrides on conflict). Read every language-agnostic module; of the\n"
            f"`styling.<language>` modules read ONLY those whose language appears in\n"
            f"the files you are reviewing:\n{module_lines}\n"
        )
    else:
        lens_block = (
            f"PRIMARY lens: verify the changed lines against the project's CLAUDE.md\n"
            f"conventions (naming, suffixes, file layout, model placement, class\n"
            f"size, typing, tests, cascading).\n"
        )

    review_prompt = (
        f"Review ONLY the git-diff changes written for task '{tag}' (target: {target}).\n"
        f"Scope (HARD RULES — violations produce false flags):\n"
        f"  1. Run `git diff HEAD --stat` and `git status --short`, then read the\n"
        f"     component spec at {component_spec} to identify which of those\n"
        f"     changed files implement THIS task. Review only that intersection.\n"
        f"  2. Within each file, flag ONLY lines that are added or modified in the\n"
        f"     diff. Pre-existing code — even in the same file, even moved code\n"
        f"     whose content is unchanged — is OUT of scope. Never flag it.\n"
        f"  3. Do NOT read or review files outside the diff.\n\n"
        f"{lens_block}"
        f"SECONDARY lens — task-level correctness of the changed lines against the\n"
        f"component spec's promised behaviour. Core: wrong conditionals, unhandled edge\n"
        f"cases, swallowed exceptions, async bugs, shared-state mutation, silent-success\n"
        f"paths. Full checklist: the resolved review module above.\n"
        f"Record each finding as a note (do NOT complete the task — completion\n"
        f"stays with the implementing agent):\n"
        f"  schematic task note {tag} \"<finding>\" --schematic {schematic_dir.name}\n"
        f"Final line of your reply: VERDICT: clean | VERDICT: findings\n"
    )

    print(f"  ↪ SESSION AGENT: launch this review as a {review_model} subagent (Agent tool),")
    print(f"    then record the verdict: schematic task review-result {tag} <clean|findings> --summary \"<one line>\" --schematic {schematic_dir.name}")
    print("    Task cannot complete until the recorded verdict is 'clean'.\n")
    print("  ── review prompt ───────────────────────────────────────────────")
    print(textwrap.indent(review_prompt, "  "))
    print("  ────────────────────────────────────────────────────────────────")


def _task_review_result(args: argparse.Namespace) -> None:
    schematic_dir = resolve_schematic_dir(args.schematic)
    state = load_state(schematic_dir)
    task_state = state["tasks"].get(args.tag)
    if not task_state or "review_request" not in task_state:
        _exit_error(
            f"no review request recorded for task {args.tag}\n"
            f"  run: schematic task status {args.tag} review --schematic {args.schematic}"
        )

    review_request = task_state["review_request"]
    review_request["status"] = args.verdict
    review_request["summary"] = args.summary
    review_request["recorded_at"] = datetime.now(tz=timezone.utc).isoformat()
    save_state(schematic_dir, state)
    print(f"review result for {args.tag}: {args.verdict} — {args.summary}")
    if args.verdict == REVIEW_VERDICT_CLEAN:
        print(f"  next: schematic task complete {args.tag} --schematic {args.schematic}")
    else:
        print("  resolve every finding (see task notes), re-run tests, then re-dispatch:")
        print(f"  schematic task status {args.tag} review --schematic {args.schematic}")


def _task_complete(args: argparse.Namespace) -> None:
    schematic_dir = resolve_schematic_dir(args.schematic)
    tasks_md = schematic_dir / "tasks.md"
    tasks = parse_tasks(tasks_md)
    task = next((t for t in tasks if t["tag"] == args.tag), None)
    if not task:
        _exit_error(f"task '{args.tag}' not found in tasks.md")

    open_question_idxs = _unanswered_question_idxs(schematic_dir, args.tag)
    if open_question_idxs:
        open_question_ids = ", ".join(
            f"{TASK_QUESTIONS_STEM}#{idx}" for idx in open_question_idxs
        )
        _exit_error(
            f"task {args.tag} has unanswered question(s): {open_question_ids}\n"
            f"  A note is not a state — an open question is closed by the user answering it,\n"
            f"  and --override does not close one.\n"
            f"  answer: schematic answer {TASK_QUESTIONS_STEM}#<idx> \"<text>\" {schematic_dir.name}"
        )

    review_state = load_state(schematic_dir)["tasks"].get(args.tag, {}).get("review_request")
    review_verdict = review_state["status"] if review_state else None
    if review_verdict != REVIEW_VERDICT_CLEAN:
        if args.override:
            state = load_state(schematic_dir)
            record_override(
                state,
                f"task complete {args.tag} without clean review (verdict: {review_verdict or 'never dispatched'})",
                args.override,
            )
            save_state(schematic_dir, state)
        else:
            _exit_error(
                f"task {args.tag} has no clean review recorded "
                f"(review verdict: {review_verdict or 'never dispatched'})\n"
                f"  run: schematic task status {args.tag} review --schematic {args.schematic}\n"
                f"  then: schematic task review-result {args.tag} clean --summary \"<one line>\" --schematic {args.schematic}\n"
                f"  or:   schematic task complete {args.tag} --schematic {args.schematic} --override \"<reason>\""
            )

    if task["status"] not in {TASK_STATUS_IN_PROGRESS, TASK_STATUS_REVIEW}:
        if args.override:
            state = load_state(schematic_dir)
            record_override(
                state,
                f"task complete {args.tag} (was '{task['status']}')",
                args.override,
            )
            save_state(schematic_dir, state)
        else:
            _exit_error(
                f"task {args.tag} must be in_progress or review to complete "
                f"(currently: '{task['status']}')\n"
                f"  run: schematic task status {args.tag} in_progress --schematic {args.schematic}\n"
                f"  or:  schematic task complete {args.tag} --schematic {args.schematic} "
                f"--override \"<reason>\""
            )

    update_task_status_in_file(tasks_md, args.tag, TASK_STATUS_COMPLETE)
    state = load_state(schematic_dir)
    state["tasks"].setdefault(args.tag, {})["status"] = TASK_STATUS_COMPLETE
    save_state(schematic_dir, state)
    print(f"task {args.tag}: complete ✓")


def _claim_task_in_progress(schematic_dir: Path, tag: str) -> None:
    """Move a task pending → in_progress in tasks.md and the state file."""
    update_task_status_in_file(schematic_dir / "tasks.md", tag, TASK_STATUS_IN_PROGRESS)
    state = load_state(schematic_dir)
    state["tasks"].setdefault(tag, {})["status"] = TASK_STATUS_IN_PROGRESS
    save_state(schematic_dir, state)


def _servable_task(schematic_dir: Path) -> TaskRecord | None:
    """The next pending unblocked task, never one past an unsigned milestone boundary."""
    tasks = parse_tasks(schematic_dir / "tasks.md")
    complete_tags = {t["tag"] for t in tasks if t["status"] == TASK_STATUS_COMPLETE}
    servable_tags = _tags_inside_the_open_milestone(schematic_dir=schematic_dir, tasks=tasks)

    for task in tasks:
        if task["status"] != TASK_STATUS_PENDING:
            continue
        if servable_tags is not None and task["tag"] not in servable_tags:
            continue
        active_blockers = [b for b in task["blocked_by"] if b not in complete_tags]
        if active_blockers:
            continue
        return task
    return None


def _task_next(args: argparse.Namespace) -> None:
    name = getattr(args, "name", None)
    peek = getattr(args, "peek", False)
    schematic_dirs = _resolve_single_or_all(name)
    for schematic_dir in schematic_dirs:
        _refuse_a_lost_milestone_table(schematic_dir)

    for schematic_dir in schematic_dirs:
        servable_task = _servable_task(schematic_dir)
        if servable_task is None:
            continue
        print(f"schematic: {schematic_dir.name}")
        print("\n".join(servable_task["raw_lines"]))
        if not peek:
            _claim_task_in_progress(schematic_dir=schematic_dir, tag=servable_task["tag"])
            print(f"\n→ task {servable_task['tag']}: pending → in_progress")
        return

    if not peek:
        for schematic_dir in schematic_dirs:
            if _announce_milestone_boundary(schematic_dir=schematic_dir):
                return

    for schematic_dir in schematic_dirs:
        # Outside --peek a drained boundary already spoke for itself in _announce_milestone_boundary.
        _print_open_milestone_hold(schematic_dir=schematic_dir, include_drained=peek)
    print("no pending unblocked tasks found")


def _task_note(args: argparse.Namespace) -> None:
    schematic_dir = resolve_schematic_dir(args.schematic)
    state = load_state(schematic_dir)
    task_state = state["tasks"].setdefault(args.tag, {})
    notes = task_state.setdefault("notes", [])
    notes.append({"text": args.text, "ts": datetime.now(tz=timezone.utc).isoformat()})
    save_state(schematic_dir, state)
    print(f"note added to {args.tag}: {args.text}")


def _task_decision(args: argparse.Namespace) -> None:
    """Record a non-contract choice the schematic didn't answer; anything heavier must be asked."""
    schematic_dir = resolve_schematic_dir(args.schematic)
    if args.kind not in VALID_DECISION_KINDS:
        _exit_error(
            f"'{args.kind}' is not a decision an agent may take alone "
            f"(valid kinds: {', '.join(sorted(VALID_DECISION_KINDS))}).\n"
            f"  A choice that changes a signed contract, adds a caveat, or picks a value the\n"
            f"  card did not specify belongs to the user — hold the task and ask:\n"
            f"  schematic task ask {args.tag} \"<question>\" --schematic {args.schematic}"
        )

    state = load_state(schematic_dir)
    task_state = state["tasks"].setdefault(args.tag, {})
    decisions = task_state.setdefault("decisions", [])
    decisions.append({
        "text": args.text,
        "kind": args.kind,
        "ts": datetime.now(tz=timezone.utc).isoformat(),
    })
    save_state(schematic_dir, state)
    print(f"decision recorded for {args.tag} ({args.kind}): {args.text}")


def _tag_to_decisions(state: dict, tags: set[str]) -> dict[str, list[dict]]:
    """Recorded autonomous decisions per task tag, restricted to the tags asked for."""
    return {
        tag: task_state["decisions"]
        for tag, task_state in state["tasks"].items()
        if task_state.get("decisions") and tag in tags
    }


def _print_decision_ledger(state: dict) -> None:
    """Print every recorded autonomous decision so the master folds them into implementation_report.md."""
    tag_to_decisions = _tag_to_decisions(state=state, tags=set(state["tasks"]))
    if not tag_to_decisions:
        return
    print()
    print("AUTONOMOUS DECISIONS (fold into implementation_report.md § Autonomous decisions):")
    for tag, decisions in sorted(tag_to_decisions.items()):
        for decision in decisions:
            print(f"  {tag}: {decision['text']}")


# ── milestone commands (optional multi-stage delivery) ─────────────────────────

@dataclass(frozen=True)
class MilestoneAmendment:
    """A re-scoped Milestones table and the one-line delta that produced it."""
    milestones: tuple[Milestone, ...]
    delta: str


@dataclass(frozen=True)
class ResolvedMilestone:
    """One milestone with the state and table it was read from, and the tasks it owns."""
    state: dict
    milestones: list[Milestone]
    milestone: Milestone
    milestone_tasks: list[TaskRecord]


def cmd_milestone(args: argparse.Namespace) -> None:
    """Dispatch a `schematic milestone <subcommand>` to its handler."""
    milestone_handlers = {
        "decide": _milestone_decide,
        "propose": _milestone_propose,
        "lock": _milestone_lock,
        "status": _milestone_status,
        "sign-off": _milestone_signoff,
        "report": _milestone_report,
        "amend": _milestone_amend,
    }
    milestone_handlers[args.milestone_command](args)


def _milestone_decision_is_locked(state: dict) -> bool:
    """True when the state records a `yes` decision the user has locked."""
    milestone_state = state["milestones"]
    return bool(
        milestone_state
        and milestone_state["decision"] == MILESTONE_DECISION_YES
        and milestone_state["locked_at"]
    )


def _milestones_are_locked(state: dict, milestones: list[Milestone]) -> bool:
    """True when the user locked a `yes` decision over a non-empty Milestones table."""
    return _milestone_decision_is_locked(state) and bool(milestones)


def _milestone_table_is_lost(state: dict, milestones: list[Milestone]) -> bool:
    """True when the lock is recorded but tasks.md no longer carries the table it locked."""
    return _milestone_decision_is_locked(state) and not milestones


def _refuse_a_lost_milestone_table(schematic_dir: Path) -> None:
    """Exit rather than let a deleted Milestones table silently open the boundary gate."""
    if _milestone_table_is_lost(
        state=load_state(schematic_dir),
        milestones=parse_milestones(schematic_dir / "tasks.md"),
    ):
        _exit_error(
            f"{schematic_dir.name}: {MILESTONE_TABLE_LOST_FINDING} — the boundary gate cannot hold.\n"
            f"  restore the `{MILESTONES_HEADING}` table in tasks.md, then re-run"
        )


def _open_milestone(state: dict, milestones: list[Milestone]) -> Milestone | None:
    """The earliest milestone the user has not signed off — None once every one is signed."""
    signed_off_ids = set(state["milestones"]["signed_off"])
    return next(
        (milestone for milestone in milestones if milestone.id not in signed_off_ids),
        None,
    )


def _open_milestone_id(schematic_dir: Path, state: dict) -> str | None:
    """The open milestone's id — None when this bundle has no locked milestones."""
    milestones = parse_milestones(schematic_dir / "tasks.md")
    if not _milestones_are_locked(state=state, milestones=milestones):
        return None
    open_milestone = _open_milestone(state=state, milestones=milestones)
    return open_milestone.id if open_milestone else None


def _milestone_tasks(
    tasks: list[TaskRecord],
    milestones: list[Milestone],
    milestone: Milestone,
) -> list[TaskRecord]:
    """The tasks this milestone owns, in tasks.md order."""
    tag_to_milestone_id = _tag_to_milestone_id(tasks=tasks, milestones=milestones)
    return [task for task in tasks if tag_to_milestone_id.get(task["tag"]) == milestone.id]


def _tags_inside_the_open_milestone(
    schematic_dir: Path,
    tasks: list[TaskRecord],
) -> set[str] | None:
    """The tags `task next` may serve — None when no milestone gate applies to this bundle."""
    state = load_state(schematic_dir)
    milestones = parse_milestones(schematic_dir / "tasks.md")
    if not _milestones_are_locked(state=state, milestones=milestones):
        return None
    open_milestone = _open_milestone(state=state, milestones=milestones)
    if open_milestone is None:
        return set()
    return {
        task["tag"]
        for task in _milestone_tasks(tasks=tasks, milestones=milestones, milestone=open_milestone)
    }


def _milestone_phase_refusal(schematic_dir: Path, num: int, schematic_name: str) -> str:
    """Why this phase cannot lock on milestone grounds — empty when it can."""
    state = load_state(schematic_dir)
    milestones = parse_milestones(schematic_dir / "tasks.md")
    milestone_state = state["milestones"]

    if num == PLANNING_FINAL_PHASE:
        if not milestone_state:
            return (
                f"phase {PLANNING_FINAL_PHASE} requires a milestone decision before locking.\n"
                f"  ask the user: \"Split this task set into a multi-stage delivery using milestones?\"\n"
                f"  then record it: schematic milestone decide yes|no --schematic {schematic_name}"
            )
        if milestone_state["decision"] == MILESTONE_DECISION_YES and not milestone_state["locked_at"]:
            return (
                f"phase {PLANNING_FINAL_PHASE} has a 'yes' milestone decision with nothing locked.\n"
                f"  write the `{MILESTONES_HEADING}` table into tasks.md, then:\n"
                f"  schematic milestone propose --schematic {schematic_name}\n"
                f"  schematic milestone lock --schematic {schematic_name}"
            )
        return ""

    if num == IMPLEMENTATION_PHASE:
        return _implementation_phase_milestone_refusal(
            state=state,
            milestones=milestones,
            schematic_name=schematic_name,
        )
    return ""


def _implementation_phase_milestone_refusal(
    state: dict,
    milestones: list[Milestone],
    schematic_name: str,
) -> str:
    """Why Phase 8 cannot lock — a lost Milestones table, or an unsigned milestone (GATE 3)."""
    if _milestone_table_is_lost(state=state, milestones=milestones):
        return (
            f"phase {IMPLEMENTATION_PHASE} cannot lock — {MILESTONE_TABLE_LOST_FINDING}.\n"
            f"  restore the `{MILESTONES_HEADING}` table in tasks.md, then sign each milestone off"
        )
    if not _milestones_are_locked(state=state, milestones=milestones):
        return ""
    unsigned_ids = [
        milestone.id for milestone in milestones
        if milestone.id not in state["milestones"]["signed_off"]
    ]
    if not unsigned_ids:
        return ""
    return (
        f"phase {IMPLEMENTATION_PHASE} cannot lock — {len(unsigned_ids)} milestone(s) "
        f"unsigned: {', '.join(unsigned_ids)}\n"
        f"  sign each off: schematic milestone sign-off <id> --schematic {schematic_name}"
    )


def _exit_milestone_findings(findings: list[str]) -> NoReturn:
    """Print every way the Milestones table fails the task graph, then exit 1."""
    print(f"⚠️  the Milestones table does not partition the task graph — {len(findings)} finding(s):\n")
    for index, finding in enumerate(findings, 1):
        print(f"  {index}. {finding}")
    sys.exit(1)


def _require_locked_milestone(
    schematic_dir: Path,
    state: dict,
    milestones: list[Milestone],
    milestone_id: str,
    schematic_name: str,
) -> Milestone:
    """The named milestone — exits when the bundle has no locked table or the id is unknown."""
    if not _milestones_are_locked(state=state, milestones=milestones):
        _exit_error(
            f"{schematic_dir.name} has no locked milestones.\n"
            f"  decide, propose and lock them first: "
            f"schematic milestone decide yes --schematic {schematic_name}"
        )
    milestone = next((m for m in milestones if m.id == milestone_id), None)
    if milestone is None:
        _exit_error(
            f"unknown milestone '{milestone_id}' — this bundle declares "
            f"{', '.join(m.id for m in milestones)}"
        )
    return milestone


def _resolved_milestone(
    schematic_dir: Path,
    state: dict,
    milestones: list[Milestone],
    milestone: Milestone,
) -> ResolvedMilestone:
    """Pair a milestone with the tasks it owns in tasks.md."""
    return ResolvedMilestone(
        state=state,
        milestones=milestones,
        milestone=milestone,
        milestone_tasks=_milestone_tasks(
            tasks=parse_tasks(schematic_dir / "tasks.md"),
            milestones=milestones,
            milestone=milestone,
        ),
    )


def _named_locked_milestone(
    schematic_dir: Path,
    milestone_id: str,
    schematic_name: str,
) -> ResolvedMilestone:
    """The named milestone of a locked table — exits when there is none or the id is unknown."""
    state = load_state(schematic_dir)
    milestones = parse_milestones(schematic_dir / "tasks.md")
    return _resolved_milestone(
        schematic_dir=schematic_dir,
        state=state,
        milestones=milestones,
        milestone=_require_locked_milestone(
            schematic_dir=schematic_dir,
            state=state,
            milestones=milestones,
            milestone_id=milestone_id,
            schematic_name=schematic_name,
        ),
    )


def _open_locked_milestone(schematic_dir: Path) -> ResolvedMilestone | None:
    """The bundle's open milestone — None when no locked milestone is still unsigned."""
    state = load_state(schematic_dir)
    milestones = parse_milestones(schematic_dir / "tasks.md")
    if not _milestones_are_locked(state=state, milestones=milestones):
        return None
    open_milestone = _open_milestone(state=state, milestones=milestones)
    if open_milestone is None:
        return None
    return _resolved_milestone(
        schematic_dir=schematic_dir,
        state=state,
        milestones=milestones,
        milestone=open_milestone,
    )


def _milestone_proposal_findings(
    schematic_dir: Path,
    state: dict,
    schematic_name: str,
) -> list[str]:
    """Everything wrong with the proposed table; exits when the gate itself is unreachable."""
    milestone_state = state["milestones"]
    if not milestone_state:
        _exit_error(
            "no milestone decision recorded — ask the user first:\n"
            f"  schematic milestone decide yes|no --schematic {schematic_name}"
        )
    if milestone_state["decision"] != MILESTONE_DECISION_YES:
        _exit_error(
            f"the recorded decision is '{milestone_state['decision']}' — this task set delivers "
            f"as one stage.\n"
            f"  to change it: schematic milestone decide yes --schematic {schematic_name}"
        )

    milestones = parse_milestones(schematic_dir / "tasks.md")
    if not milestones:
        _exit_error(
            f"no `{MILESTONES_HEADING}` table in tasks.md — write one row per milestone:\n"
            f"  {MILESTONE_TABLE_HEADER.splitlines()[0]}\n"
            f"  | M1 | <title> | <groups/tags> | <what it proves> |"
        )
    return _milestone_table_findings(
        tasks=parse_tasks(schematic_dir / "tasks.md"),
        milestones=milestones,
    )


def _print_milestone_membership(milestones: list[Milestone], tasks: list[TaskRecord]) -> None:
    """Show which tasks each milestone claims, so the user gates on resolved membership."""
    for milestone in milestones:
        claimed_tasks = _milestone_tasks(tasks=tasks, milestones=milestones, milestone=milestone)
        print(f"  {milestone.id}  {milestone.title}")
        print(f"      tasks:  {', '.join(task['tag'] for task in claimed_tasks)}")
        print(f"      proves: {milestone.proves}")


def _milestone_decide(args: argparse.Namespace) -> None:
    """Record the Phase-7 answer on multi-stage delivery — the CLI is the state of record."""
    schematic_dir = resolve_schematic_dir(args.schematic)
    state = load_state(schematic_dir)
    if _milestones_are_locked(
        state=state,
        milestones=parse_milestones(schematic_dir / "tasks.md"),
    ):
        _exit_error(
            "the milestones are already locked — a post-lock re-scope is an amendment:\n"
            f"  schematic milestone amend --schematic {args.schematic} "
            f"--move <tags> --to <id> --reason \"<why>\""
        )

    state["milestones"] = {
        "decision": args.answer,
        "decided_at": datetime.now(tz=timezone.utc).isoformat(),
        "proposed_at": None,
        "locked_at": None,
        "signed_off": {},
        "reported": {},
        "announced": {},
        "suite": {},
        "amendments": [],
    }
    save_state(schematic_dir, state)
    print(f"milestone decision: {args.answer}")
    if args.answer == MILESTONE_DECISION_YES:
        print(f"  next: write the `{MILESTONES_HEADING}` table into tasks.md "
              f"(M<n> | title | groups/tags | what it proves), then:")
        print(f"  schematic milestone propose --schematic {args.schematic}")
    else:
        print("  delivering as one stage — nothing else changes")
        print(f"  next: schematic phase complete {PLANNING_FINAL_PHASE} --schematic {args.schematic}")


def _milestone_propose(args: argparse.Namespace) -> None:
    """Validate the drafted table and present the resolved membership for the user's y."""
    schematic_dir = resolve_schematic_dir(args.schematic)
    state = load_state(schematic_dir)
    findings = _milestone_proposal_findings(
        schematic_dir=schematic_dir,
        state=state,
        schematic_name=args.schematic,
    )
    if findings:
        _exit_milestone_findings(findings)

    milestones = parse_milestones(schematic_dir / "tasks.md")
    state["milestones"]["proposed_at"] = datetime.now(tz=timezone.utc).isoformat()
    save_state(schematic_dir, state)

    print(f"proposed delivery: {len(milestones)} milestone(s) over the task graph\n")
    _print_milestone_membership(
        milestones=milestones,
        tasks=parse_tasks(schematic_dir / "tasks.md"),
    )
    print("\nevery task belongs to exactly one milestone and no task depends on a later one.")
    print(f"on the user's y: schematic milestone lock --schematic {args.schematic}")


def _milestone_lock(args: argparse.Namespace) -> None:
    """Lock the proposed milestones — the boundary gate starts holding from here."""
    schematic_dir = resolve_schematic_dir(args.schematic)
    state = load_state(schematic_dir)
    milestones = parse_milestones(schematic_dir / "tasks.md")
    if _milestones_are_locked(state=state, milestones=milestones):
        _exit_error(
            "the milestones are already locked — re-scope with:\n"
            f"  schematic milestone amend --schematic {args.schematic} "
            f"--move <tags> --to <id> --reason \"<why>\""
        )

    findings = _milestone_proposal_findings(
        schematic_dir=schematic_dir,
        state=state,
        schematic_name=args.schematic,
    )
    if findings:
        _exit_milestone_findings(findings)

    state["milestones"]["locked_at"] = datetime.now(tz=timezone.utc).isoformat()
    save_state(schematic_dir, state)
    print(f"milestones locked ✓ — {len(parse_milestones(schematic_dir / 'tasks.md'))} stage(s)")
    print("  `task next` now stops at each boundary until you sign it off")
    print(f"  next: schematic phase complete {PLANNING_FINAL_PHASE} --schematic {args.schematic}")


def _milestone_gate_label(state: dict, milestone: Milestone, open_milestone: Milestone | None) -> str:
    """How this milestone's gate reads right now."""
    signed_off_at = state["milestones"]["signed_off"].get(milestone.id)
    if signed_off_at:
        return f"signed off {signed_off_at}"
    if open_milestone is not None and open_milestone.id == milestone.id:
        return "← open milestone"
    return "waiting"


def _milestone_status_counts(milestone_tasks: list[TaskRecord]) -> str:
    """Task counts per status for one milestone, richest status first."""
    ordered_statuses = [
        TASK_STATUS_COMPLETE,
        TASK_STATUS_REVIEW,
        TASK_STATUS_IN_PROGRESS,
        TASK_STATUS_PENDING_INPUT,
        TASK_STATUS_PENDING,
    ]
    return "  ".join(
        f"{status} {len([task for task in milestone_tasks if task['status'] == status])}"
        for status in ordered_statuses
        if any(task["status"] == status for task in milestone_tasks)
    )


def _milestone_status(args: argparse.Namespace) -> None:
    """Print each milestone's task counts and gate state, and the amendments made after lock."""
    schematic_dir = resolve_schematic_dir(args.schematic)
    state = load_state(schematic_dir)
    milestones = parse_milestones(schematic_dir / "tasks.md")
    milestone_state = state["milestones"]
    if not milestones or not milestone_state or milestone_state["decision"] != MILESTONE_DECISION_YES:
        print(f"no milestones declared — {schematic_dir.name} delivers as one stage")
        return

    tasks = parse_tasks(schematic_dir / "tasks.md")
    open_milestone = _open_milestone(state=state, milestones=milestones)
    print(f"schematic:  {schematic_dir.name}")
    print(f"milestones: {len(milestones)} (locked: {milestone_state['locked_at'] or 'not locked'})")
    for milestone in milestones:
        milestone_tasks = _milestone_tasks(tasks=tasks, milestones=milestones, milestone=milestone)
        gate_label = _milestone_gate_label(
            state=state,
            milestone=milestone,
            open_milestone=open_milestone,
        )
        print(
            f"  {milestone.id}  {milestone.title:<30} "
            f"{len(milestone_tasks)} task(s): {_milestone_status_counts(milestone_tasks)}   {gate_label}"
        )
    if milestone_state["amendments"]:
        print(f"\namendments: {len(milestone_state['amendments'])}")
        for amendment in milestone_state["amendments"]:
            print(f"  {amendment['delta']} — {amendment['reason']}")


def _milestone_order_refusals(
    state: dict,
    milestone: Milestone,
    milestones: list[Milestone],
    schematic_name: str,
) -> list[str]:
    """Why this milestone is the wrong one to sign — already signed, or an earlier one is open."""
    signed_off_at = state["milestones"]["signed_off"].get(milestone.id)
    if signed_off_at:
        return [f"milestone {milestone.id} is already signed off ({signed_off_at})"]

    open_milestone = _open_milestone(state=state, milestones=milestones)
    if open_milestone is not None and open_milestone.id != milestone.id:
        return [
            f"sign the milestones off in order — {open_milestone.id} is still open "
            f"(schematic milestone sign-off {open_milestone.id} --schematic {schematic_name})"
        ]
    return []


def _milestone_task_refusals(state: dict, milestone_tasks: list[TaskRecord]) -> list[str]:
    """Tasks not complete, held on the user, or without a clean per-task review."""
    refusals: list[str] = []
    for task in milestone_tasks:
        if task["status"] == TASK_STATUS_PENDING_INPUT:
            refusals.append(
                f"task {task['tag']} is held on a user answer — answer it before signing off"
            )
        elif task["status"] != TASK_STATUS_COMPLETE:
            refusals.append(
                f"task {task['tag']} is '{task['status']}' — every task of a milestone must be complete"
            )

    for task in milestone_tasks:
        review_request = state["tasks"].get(task["tag"], {}).get("review_request")
        verdict = review_request["status"] if review_request else None
        if verdict != REVIEW_VERDICT_CLEAN:
            refusals.append(
                f"task {task['tag']} holds no clean per-task review "
                f"(verdict: {verdict or 'never dispatched'})"
            )
    return refusals


def _milestone_sweep_refusals(state: dict, milestone: Milestone) -> list[str]:
    """In auto mode, a PRISTINE sweep stamped with this milestone must exist (GATE 2)."""
    run = state["run"]
    if not run or run["mode"] != RUN_MODE_AUTO:
        return []
    pristine_sweeps = [
        sweep for sweep in state["sweeps"]
        if sweep.get("milestone") == milestone.id and sweep["pristine"]
    ]
    if pristine_sweeps:
        return []
    return [
        f"no PRISTINE standards sweep recorded for {milestone.id} — "
        f"sweep its groups first (schematic review sweep)"
    ]


def _milestone_signoff_refusals(signing_milestone: ResolvedMilestone, schematic_name: str) -> list[str]:
    """Every gate the milestone has not cleared — the review layers that close at a boundary."""
    order_refusals = _milestone_order_refusals(
        state=signing_milestone.state,
        milestone=signing_milestone.milestone,
        milestones=signing_milestone.milestones,
        schematic_name=schematic_name,
    )
    if order_refusals:
        return order_refusals
    return _milestone_task_refusals(
        state=signing_milestone.state,
        milestone_tasks=signing_milestone.milestone_tasks,
    ) + _milestone_sweep_refusals(
        state=signing_milestone.state,
        milestone=signing_milestone.milestone,
    )


def _milestone_signoff(args: argparse.Namespace) -> None:
    """Sign a drained milestone off — the only thing that opens the next one."""
    schematic_dir = resolve_schematic_dir(args.schematic)
    signing_milestone = _named_locked_milestone(
        schematic_dir=schematic_dir,
        milestone_id=args.id,
        schematic_name=args.schematic,
    )
    state = signing_milestone.state
    milestone = signing_milestone.milestone
    refusals = _milestone_signoff_refusals(
        signing_milestone=signing_milestone,
        schematic_name=args.schematic,
    )
    if refusals:
        print(f"⚠️  milestone {milestone.id} is not ready to sign off — {len(refusals)} gate(s) open:\n")
        for index, refusal in enumerate(refusals, 1):
            print(f"  {index}. {refusal}")
        sys.exit(1)

    state["milestones"]["signed_off"][milestone.id] = datetime.now(tz=timezone.utc).isoformat()
    save_state(schematic_dir, state)
    print(f"milestone {milestone.id} signed off ✓ — {len(signing_milestone.milestone_tasks)} task(s), every review clean")
    run = state["run"]
    if not run or run["mode"] != RUN_MODE_AUTO:
        print("  no standards sweep was required — this run is manual mode, where the")
        print("  per-task reviews are the standards layer (sweeps are an auto-mode gate)")

    next_milestone = _open_milestone(state=state, milestones=signing_milestone.milestones)
    if next_milestone is None:
        print(f"  every milestone is signed off — next: schematic phase complete "
              f"{IMPLEMENTATION_PHASE} --schematic {args.schematic}")
    else:
        print(f"  {next_milestone.id} is now open ({next_milestone.title}) — next: schematic task next")


def _milestone_report_heading(milestone: Milestone) -> str:
    """The H2 heading that opens this milestone's section of implementation_report.md."""
    return f"{MILESTONE_REPORT_HEADING_PREFIX}{milestone.id} — {milestone.title}"


def _milestone_task_table_lines(milestone_tasks: list[TaskRecord]) -> list[str]:
    """The report's task table — one row per task with its status and divergence flag."""
    return [
        "| Tag | Action | Target | Status | Divergence |",
        "|---|---|---|---|---|",
        *(
            f"| {task['tag']} | {task['action']} | {task['target']} | "
            f"{task['status']} | {task['divergence'] or '—'} |"
            for task in milestone_tasks
        ),
    ]


def _milestone_decision_lines(state: dict, milestone_tags: set[str]) -> list[str]:
    """One bullet per autonomous decision recorded against this milestone's tasks."""
    tag_to_decisions = _tag_to_decisions(state=state, tags=milestone_tags)
    return [
        f"- {tag}: {decision['text']}"
        for tag, decisions in sorted(tag_to_decisions.items())
        for decision in decisions
    ]


def _milestone_verdict_lines(state: dict, milestone_tasks: list[TaskRecord]) -> list[str]:
    """One bullet per task with its per-task review verdict and summary."""
    verdict_lines: list[str] = []
    for task in milestone_tasks:
        review_request = state["tasks"].get(task["tag"], {}).get("review_request")
        verdict = review_request["status"] if review_request else "never dispatched"
        summary = review_request.get("summary") if review_request else None
        verdict_lines.append(f"- {task['tag']}: {verdict} — {summary or '—'}")
    return verdict_lines


def _milestone_question_lines(schematic_dir: Path, milestone_tags: set[str]) -> list[str]:
    """One bullet per unanswered question filed by this milestone's tasks."""
    return [
        f"- {question['id']} ({question['tag']}): {question['text']}"
        for question in _pending_questions(schematic_dir)
        if question["tag"] in milestone_tags
    ]


def _milestone_sweep_line(state: dict, milestone: Milestone) -> str:
    """The standards-sweep verdict recorded for this milestone's groups."""
    milestone_sweeps = [
        sweep for sweep in state["sweeps"]
        if sweep.get("milestone") == milestone.id
    ]
    if not milestone_sweeps:
        return f"{MILESTONE_NOT_RECORDED} — no standards sweep ran for this milestone"
    latest_sweep = milestone_sweeps[-1]
    pristine_label = "PRISTINE ✓" if latest_sweep["pristine"] else "not pristine"
    return (
        f"sweep {latest_sweep['sweep_id']}: {pristine_label} "
        f"({len(latest_sweep['batches'])} batch(es))"
    )


def _render_milestone_report(schematic_dir: Path, reported_milestone: ResolvedMilestone) -> str:
    """The milestone's section of implementation_report.md — what the user signs off against."""
    state = reported_milestone.state
    milestone = reported_milestone.milestone
    milestone_tasks = reported_milestone.milestone_tasks
    milestone_tags = {task["tag"] for task in milestone_tasks}
    subsection_title_to_lines = {
        "Tasks": _milestone_task_table_lines(milestone_tasks),
        "Autonomous decisions": _milestone_decision_lines(state=state, milestone_tags=milestone_tags),
        "Review verdicts": _milestone_verdict_lines(state=state, milestone_tasks=milestone_tasks),
        "Standards sweep": [_milestone_sweep_line(state=state, milestone=milestone)],
        "Test suite": [state["milestones"]["suite"].get(milestone.id) or MILESTONE_NOT_RECORDED],
        "Open questions": _milestone_question_lines(schematic_dir, milestone_tags),
    }

    section_lines = [
        _milestone_report_heading(milestone),
        "",
        f"Proves: {milestone.proves}",
        f"Scope: {', '.join(milestone.scope)} — {len(milestone_tasks)} task(s).",
    ]
    for subsection_title, body_lines in subsection_title_to_lines.items():
        section_lines.extend(
            [
                "",
                f"### {subsection_title}",
                *(body_lines or [MILESTONE_SECTION_EMPTY]),
            ]
        )
    return "\n".join(section_lines)


def _write_milestone_report_section(report_path: Path, heading: str, section_text: str) -> None:
    """Replace this milestone's section in implementation_report.md, appending it when absent."""
    existing_report = report_path.read_text() if report_path.exists() else ""
    heading_match = re.search(rf"^{re.escape(heading)}$", existing_report, re.MULTILINE)
    if heading_match is None:
        preamble = f"{existing_report.rstrip()}\n\n" if existing_report.strip() else ""
        report_path.write_text(f"{preamble}{section_text}\n")
        return

    next_heading = re.search(r"^## ", existing_report[heading_match.end():], re.MULTILINE)
    section_end = (
        heading_match.end() + next_heading.start() if next_heading else len(existing_report)
    )
    remainder = existing_report[section_end:]
    separator = "\n\n" if remainder else "\n"
    report_path.write_text(existing_report[: heading_match.start()] + section_text + separator + remainder)


def _record_milestone_report(schematic_dir: Path, reported_milestone: ResolvedMilestone) -> str:
    """Write the milestone's section to implementation_report.md and record that it was written."""
    milestone = reported_milestone.milestone
    section_text = _render_milestone_report(
        schematic_dir=schematic_dir,
        reported_milestone=reported_milestone,
    )
    _write_milestone_report_section(
        report_path=schematic_dir / IMPLEMENTATION_REPORT_FILENAME,
        heading=_milestone_report_heading(milestone),
        section_text=section_text,
    )
    reported_milestone.state["milestones"]["reported"][milestone.id] = datetime.now(tz=timezone.utc).isoformat()
    save_state(schematic_dir, reported_milestone.state)
    return section_text


def _milestone_report(args: argparse.Namespace) -> None:
    """Write and print a milestone's report section on demand; never opens a browser."""
    schematic_dir = resolve_schematic_dir(args.schematic)
    reported_milestone = _named_locked_milestone(
        schematic_dir=schematic_dir,
        milestone_id=args.id,
        schematic_name=args.schematic,
    )
    milestone_id = reported_milestone.milestone.id
    if args.suite:
        reported_milestone.state["milestones"]["suite"][milestone_id] = args.suite

    print(_record_milestone_report(
        schematic_dir=schematic_dir,
        reported_milestone=reported_milestone,
    ))
    print(f"\nwritten to {IMPLEMENTATION_REPORT_FILENAME} — present it to the user and STOP.")
    print(f"  schematic milestone sign-off {milestone_id} --schematic {args.schematic}")


def _browser_launch_disabled() -> bool:
    """True when the operator asked the CLI never to spawn a dashboard."""
    return os.environ.get(NO_BROWSER_ENV_VAR) == NO_BROWSER_ENV_ENABLED


def _launch_dashboard(schematic_dir: Path, fragment: str) -> str | None:
    """Spawn the overview dashboard detached and return its URL — None when it never reports one."""
    dashboard_log_path = schematic_dir / DASHBOARD_LOG_FILENAME
    dashboard_command = [
        "python3", str(Path(__file__).resolve()), "overview", schematic_dir.name,
    ]
    if fragment:
        dashboard_command.extend(["--fragment", fragment])
    dashboard_process = subprocess.Popen(
        dashboard_command,
        stdout=dashboard_log_path.open("w"),
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    return _polled_ui_url(
        editor_log_path=dashboard_log_path,
        editor_process=dashboard_process,
        url_prefix=DASHBOARD_URL_LOG_PREFIX,
    )


def _present_finished_dashboard(schematic_dir: Path) -> None:
    """Open the dashboard on the locked bundle — a courtesy after the lock, so a failure only warns."""
    manual_command = f"schematic overview {schematic_dir.name}"
    if _browser_launch_disabled():
        print(f"\ndashboard: skipped ({NO_BROWSER_ENV_VAR}={NO_BROWSER_ENV_ENABLED}) — open it with: {manual_command}")
        return

    dashboard_url = _launch_dashboard(schematic_dir=schematic_dir, fragment="")
    if dashboard_url is None:
        print(f"\n⚠️  the dashboard did not start (see {DASHBOARD_LOG_FILENAME}) — "
              f"the phase is still locked; open it with: {manual_command}")
        return
    print(f"\nopening the dashboard on the finished bundle:\n  {dashboard_url}")


def _milestone_fragment(milestone_id: str) -> str:
    """The dashboard deep link that opens this milestone's report screen."""
    return f"{DASHBOARD_MILESTONE_FRAGMENT_PREFIX}{milestone_id}"


def _launch_milestone_dashboard(schematic_dir: Path, milestone_id: str) -> str:
    """Open the dashboard on this milestone's report screen; fail closed if it never opens."""
    dashboard_url = _launch_dashboard(
        schematic_dir=schematic_dir,
        fragment=_milestone_fragment(milestone_id),
    )
    if dashboard_url is None:
        _exit_error(
            f"the milestone dashboard never reported a URL — nothing presented; "
            f"see {schematic_dir / DASHBOARD_LOG_FILENAME}\n"
            f"  the report is already in {IMPLEMENTATION_REPORT_FILENAME}; re-run schematic task next"
        )
    return dashboard_url


def _present_milestone_dashboard(schematic_dir: Path, milestone_id: str) -> None:
    """Open the dashboard on this milestone's report — skipped when the operator set no-browser."""
    if _browser_launch_disabled():
        print(
            f"\ndashboard: skipped ({NO_BROWSER_ENV_VAR}={NO_BROWSER_ENV_ENABLED}) — open it with: "
            f"schematic overview {schematic_dir.name} --fragment {_milestone_fragment(milestone_id)}"
        )
        return
    dashboard_url = _launch_milestone_dashboard(schematic_dir=schematic_dir, milestone_id=milestone_id)
    print(f"\ndashboard: {dashboard_url}#{_milestone_fragment(milestone_id)}")


def _announce_milestone_boundary(schematic_dir: Path) -> bool:
    """Report and present a freshly drained milestone; True only when this call announced it."""
    open_milestone = _open_locked_milestone(schematic_dir)
    if open_milestone is None:
        return False
    milestone_tasks = open_milestone.milestone_tasks
    if not milestone_tasks or any(t["status"] != TASK_STATUS_COMPLETE for t in milestone_tasks):
        return False

    milestone_id = open_milestone.milestone.id
    milestone_state = open_milestone.state["milestones"]
    if milestone_id in milestone_state["announced"]:
        _print_milestone_awaiting_sign_off(schematic_dir=schematic_dir, milestone_id=milestone_id)
        return False

    print(f"schematic: {schematic_dir.name}")
    print(f"MILESTONE {milestone_id} HIT — the board is drained up to it, and nothing past it starts.\n")
    print(_record_milestone_report(schematic_dir=schematic_dir, reported_milestone=open_milestone))
    _present_milestone_dashboard(schematic_dir=schematic_dir, milestone_id=milestone_id)
    milestone_state["announced"][milestone_id] = datetime.now(tz=timezone.utc).isoformat()
    save_state(schematic_dir, open_milestone.state)
    print("\npresent the report above and STOP. On the user's sign-off:")
    print(f"  schematic milestone sign-off {milestone_id} --schematic {schematic_dir.name}")
    return True


def _print_milestone_awaiting_sign_off(schematic_dir: Path, milestone_id: str) -> None:
    """Name a drained milestone and the one command that lifts its gate."""
    print(f"{schematic_dir.name}: milestone {milestone_id} is drained — still waiting on your sign-off:")
    print(f"  schematic milestone sign-off {milestone_id} --schematic {schematic_dir.name}")


def _print_open_milestone_hold(schematic_dir: Path, include_drained: bool) -> None:
    """Name what the open milestone waits on — its unfinished tasks, or (when asked) its sign-off."""
    open_milestone = _open_locked_milestone(schematic_dir)
    if open_milestone is None:
        return
    unfinished_labels = [
        f"{task['tag']} ({task['status']})"
        for task in open_milestone.milestone_tasks
        if task["status"] != TASK_STATUS_COMPLETE
    ]
    if unfinished_labels:
        print(
            f"{schematic_dir.name}: milestone {open_milestone.milestone.id} is open — "
            f"not yet complete: {', '.join(unfinished_labels)}"
        )
    elif include_drained:
        _print_milestone_awaiting_sign_off(
            schematic_dir=schematic_dir,
            milestone_id=open_milestone.milestone.id,
        )


def _scope_with_tags(scope: tuple[str, ...], added_tags: tuple[str, ...]) -> tuple[str, ...]:
    """The scope with these tags appended, skipping any it already names."""
    return tuple([*scope, *[tag for tag in added_tags if tag not in scope]])


def _scope_without_tags(
    scope: tuple[str, ...],
    removed_tags: tuple[str, ...],
    tasks: list[TaskRecord],
) -> tuple[str, ...]:
    """The scope with these tags gone — a group letter expands to the tags it still owns."""
    all_tags = [task["tag"] for task in tasks]
    remaining_scope: list[str] = []
    for token in scope:
        if MILESTONE_SCOPE_TAG_RE.match(token):
            if token not in removed_tags:
                remaining_scope.append(token)
            continue
        group_tags = [tag for tag in all_tags if tag.startswith(f"{token}.")]
        if not any(tag in removed_tags for tag in group_tags):
            remaining_scope.append(token)
            continue
        remaining_scope.extend(tag for tag in group_tags if tag not in removed_tags)
    return tuple(remaining_scope)


def _milestones_after_move(
    milestones: list[Milestone],
    tasks: list[TaskRecord],
    moved_tags: tuple[str, ...],
    destination_id: str,
) -> MilestoneAmendment:
    """The table with these tags reassigned to the destination milestone."""
    amended_milestones = tuple(
        Milestone(
            id=milestone.id,
            title=milestone.title,
            scope=(
                _scope_with_tags(scope=milestone.scope, added_tags=moved_tags)
                if milestone.id == destination_id
                else _scope_without_tags(
                    scope=milestone.scope,
                    removed_tags=moved_tags,
                    tasks=tasks,
                )
            ),
            proves=milestone.proves,
        )
        for milestone in milestones
    )
    return MilestoneAmendment(
        milestones=amended_milestones,
        delta=f"moved {', '.join(moved_tags)} to {destination_id}",
    )


def _milestones_after_add(milestones: list[Milestone], added: Milestone) -> MilestoneAmendment:
    """The table with one more milestone appended."""
    return MilestoneAmendment(
        milestones=(*milestones, added),
        delta=f"added {added.id} ({added.title}) over {', '.join(added.scope)}",
    )


def _amendment_from_move(
    args: argparse.Namespace,
    milestones: list[Milestone],
    tasks: list[TaskRecord],
    state: dict,
) -> MilestoneAmendment:
    """Validate a --move/--to pair and return the amended table."""
    if not args.to:
        _exit_error("--move needs its destination: --to <milestone id>")
    if all(milestone.id != args.to for milestone in milestones):
        _exit_error(
            f"unknown destination milestone '{args.to}' — this bundle declares "
            f"{', '.join(milestone.id for milestone in milestones)}"
        )
    moved_tags = tuple(tag.strip() for tag in args.move.split(",") if tag.strip())
    all_tags = {task["tag"] for task in tasks}
    unknown_tags = [tag for tag in moved_tags if tag not in all_tags]
    if unknown_tags:
        _exit_error(f"not a task in tasks.md: {', '.join(unknown_tags)}")
    if args.to in state["milestones"]["signed_off"]:
        _exit_error(
            f"milestone {args.to} is already signed off — work cannot be moved into a "
            f"closed stage; add a later milestone instead:\n"
            f"  schematic milestone amend --schematic {args.schematic} --add M<n> "
            f"--title \"<t>\" --scope \"<tags>\" --proves \"<what>\" --reason \"<why>\""
        )
    return _milestones_after_move(
        milestones=milestones,
        tasks=tasks,
        moved_tags=moved_tags,
        destination_id=args.to,
    )


def _amendment_from_add(
    args: argparse.Namespace,
    milestones: list[Milestone],
) -> MilestoneAmendment:
    """Validate an --add and return the amended table."""
    if not (args.title and args.scope and args.proves):
        _exit_error("--add needs --title, --scope and --proves — a milestone says what it proves")
    if not MILESTONE_ID_RE.match(args.add):
        _exit_error(f"'{args.add}' is not a milestone id — use M<n> (e.g. M3)")
    if any(milestone.id == args.add for milestone in milestones):
        _exit_error(f"milestone {args.add} already exists — move tasks into it instead")
    return _milestones_after_add(
        milestones=milestones,
        added=Milestone(
            id=args.add,
            title=args.title,
            scope=tuple(token.strip() for token in args.scope.split(",") if token.strip()),
            proves=args.proves,
        ),
    )


def _requested_amendment(
    args: argparse.Namespace,
    milestones: list[Milestone],
    tasks: list[TaskRecord],
    state: dict,
) -> MilestoneAmendment:
    """The one delta the command names (a --move or an --add), checked against every table rule."""
    if bool(args.move) == bool(args.add):
        _exit_error(
            "name exactly one delta:\n"
            "  --move <tags> --to <id>        move tasks between milestones\n"
            "  --add M<n> --title \"<t>\" --scope \"<tags>\" --proves \"<what>\"   add one"
        )
    amendment = (
        _amendment_from_move(args=args, milestones=milestones, tasks=tasks, state=state)
        if args.move
        else _amendment_from_add(args=args, milestones=milestones)
    )
    findings = _milestone_table_findings(
        tasks=tasks,
        milestones=list(amendment.milestones),
    )
    if findings:
        _exit_milestone_findings(findings)
    return amendment


def _milestone_ids_with_changed_membership(
    tasks: list[TaskRecord],
    milestones_before: list[Milestone],
    milestones_after: list[Milestone],
) -> set[str]:
    """Milestones that gained or lost a task between the two tables."""
    tag_to_id_before = _tag_to_milestone_id(tasks=tasks, milestones=milestones_before)
    tag_to_id_after = _tag_to_milestone_id(tasks=tasks, milestones=milestones_after)
    return {
        milestone_id
        for tag, id_after in tag_to_id_after.items()
        if tag_to_id_before.get(tag) != id_after
        for milestone_id in (tag_to_id_before.get(tag), id_after)
        if milestone_id is not None
    }


def _record_milestone_amendment(
    schematic_dir: Path,
    state: dict,
    milestones_before: list[Milestone],
    amendment: MilestoneAmendment,
    reason: str,
) -> None:
    """Rewrite the table, log the amendment, and re-arm the boundary of every re-scoped milestone."""
    for rescoped_id in _milestone_ids_with_changed_membership(
        tasks=parse_tasks(schematic_dir / "tasks.md"),
        milestones_before=milestones_before,
        milestones_after=list(amendment.milestones),
    ):
        state["milestones"]["announced"].pop(rescoped_id, None)
    write_milestone_table(schematic_dir / "tasks.md", list(amendment.milestones))
    state["milestones"]["amendments"].append({
        "at": datetime.now(tz=timezone.utc).isoformat(),
        "delta": amendment.delta,
        "reason": reason,
    })
    save_state(schematic_dir, state)


def _milestone_amend(args: argparse.Namespace) -> None:
    """Post-lock re-scope: move tasks between milestones, or add one — recorded as an amendment."""
    schematic_dir = resolve_schematic_dir(args.schematic)
    state = load_state(schematic_dir)
    milestones = parse_milestones(schematic_dir / "tasks.md")
    if not _milestones_are_locked(state=state, milestones=milestones):
        _exit_error(
            "nothing to amend — this bundle has no locked milestones.\n"
            f"  propose and lock them first: schematic milestone propose --schematic {args.schematic}"
        )

    tasks = parse_tasks(schematic_dir / "tasks.md")
    amendment = _requested_amendment(
        args=args,
        milestones=milestones,
        tasks=tasks,
        state=state,
    )
    _record_milestone_amendment(
        schematic_dir=schematic_dir,
        state=state,
        milestones_before=milestones,
        amendment=amendment,
        reason=args.reason,
    )
    print(f"milestone amendment recorded: {amendment.delta} — {args.reason}\n")
    print(_render_milestone_table(list(amendment.milestones)))
    print(f"\nre-validate the bundle: schematic validate {args.schematic}")


# ── dashboard Q&A relay (questions asked in the browser UIs) ─────────────────────

QUESTIONS_SUFFIX = ".questions.json"
ANSWERS_SUFFIX = ".answers.json"
AGENT_REQUESTS_SUFFIX = ".agent-requests.json"
TASK_QUESTIONS_STEM = "tasks"  # `task ask` files into the same relay the dashboard bubbles use


def _load_json_list(path: Path) -> list[dict]:
    if not path.exists():
        return []
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError:
        return []


def _pending_questions(schematic_dir: Path) -> list[dict]:
    """Unanswered UI questions across the bundle: [{id, source, idx, text, prompt}]."""
    pending: list[dict] = []
    for questions_path in sorted(schematic_dir.glob(f"*{QUESTIONS_SUFFIX}")):
        stem = questions_path.name[: -len(QUESTIONS_SUFFIX)]
        answered_idxs = {
            a.get("idx") for a in _load_json_list(schematic_dir / f"{stem}{ANSWERS_SUFFIX}")
        }
        idx_to_prompt = {
            r.get("idx"): r.get("prompt", "")
            for r in _load_json_list(schematic_dir / f"{stem}{AGENT_REQUESTS_SUFFIX}")
        }
        for position, question in enumerate(_load_json_list(questions_path)):
            idx = question.get("server_idx", question.get("idx", position))
            if idx in answered_idxs:
                continue
            user_msgs = [m.get("text", "") for m in question.get("thread", []) if m.get("role") == "user"]
            text = user_msgs[-1] if user_msgs else question.get("text", "")
            if not text:
                continue
            pending.append({
                "id": f"{stem}#{idx}",
                "source": stem,
                "idx": idx,
                "tag": question.get("tag", ""),
                "text": text,
                "context": question.get("context", ""),
                "prompt": idx_to_prompt.get(idx, ""),
            })
    return pending


def cmd_questions(args: argparse.Namespace) -> None:
    total_pending = 0
    for schematic_dir in _resolve_single_or_all(args.name):
        pending = _pending_questions(schematic_dir)
        if not pending:
            continue
        total_pending += len(pending)
        print(f"schematic: {schematic_dir.name} — {len(pending)} unanswered dashboard question(s)\n")
        for question in pending:
            print(f"── {question['id']}  ({question['context'] or 'dashboard'}) ──")
            if question["prompt"]:
                print(question["prompt"])
            else:
                print(f"  User: {question['text']}")
            print()
        print(f"answer with: schematic answer <id> \"<text>\" {schematic_dir.name}")
        print("  (the dashboard bubble picks the answer up live)")
    if total_pending == 0:
        print("no unanswered dashboard questions")


def _resume_task_answered_by(schematic_dir: Path, question_idx: int) -> None:
    """Return a held task to in_progress once the answer closes its last open question."""
    state = load_state(schematic_dir)
    answered_tag = next(
        (
            tag
            for tag, task_state in state["tasks"].items()
            for question in task_state.get("questions", [])
            if question["idx"] == question_idx
        ),
        None,
    )
    if answered_tag is None:
        return
    if _unanswered_question_idxs(schematic_dir, answered_tag):
        return

    tasks_md = schematic_dir / "tasks.md"
    task = next((t for t in parse_tasks(tasks_md) if t["tag"] == answered_tag), None)
    if task is None or task["status"] != TASK_STATUS_PENDING_INPUT:
        return

    update_task_status_in_file(
        tasks_md=tasks_md,
        tag=answered_tag,
        new_status=TASK_STATUS_IN_PROGRESS,
    )
    state["tasks"][answered_tag]["status"] = TASK_STATUS_IN_PROGRESS
    save_state(schematic_dir, state)
    print(f"task {answered_tag}: {TASK_STATUS_PENDING_INPUT} → {TASK_STATUS_IN_PROGRESS}")


def cmd_answer(args: argparse.Namespace) -> None:
    if "#" not in args.id:
        _exit_error(f"invalid question id '{args.id}' — expected <source>#<idx> (e.g. overview#0, sequence#2)")
    stem, _, idx_text = args.id.partition("#")
    if not idx_text.isdigit():
        _exit_error(f"invalid question id '{args.id}' — idx must be a number")
    idx = int(idx_text)

    schematic_dirs = _resolve_single_or_all(args.name)
    for schematic_dir in schematic_dirs:
        questions_path = schematic_dir / f"{stem}{QUESTIONS_SUFFIX}"
        if not questions_path.exists():
            continue
        answers_path = schematic_dir / f"{stem}{ANSWERS_SUFFIX}"
        answers = _load_json_list(answers_path)
        answers.append({"idx": idx, "answer": args.text})
        answers_path.write_text(json.dumps(answers, indent=2) + "\n")
        print(f"answer delivered to {args.id} ({schematic_dir.name}) — the dashboard picks it up within ~2s")
        if stem == TASK_QUESTIONS_STEM:
            _resume_task_answered_by(schematic_dir=schematic_dir, question_idx=idx)
        return
    _exit_error(f"no question source '{stem}' found ({stem}{QUESTIONS_SUFFIX} missing in the schematic dir)")


# ── review (auto-mode driver + per-group standards sweep + consistency + e2e tracing) ──

def cmd_review(args: argparse.Namespace) -> None:
    handlers = {
        "start": _review_start,
        "sweep": _review_sweep,
        "batch-result": _review_batch_result,
        "consistency": _review_consistency,
        "consistency-result": _review_consistency_result,
        "e2e": _review_e2e,
        "e2e-result": _review_e2e_result,
        "status": _review_status,
    }
    handlers[args.review_command](args)


def _review_start(args: argparse.Namespace) -> None:
    schematic_dir = resolve_schematic_dir(args.schematic)
    project_root = find_project_root()
    mode = RUN_MODE_AUTO if args.auto else RUN_MODE_MANUAL
    if mode == RUN_MODE_AUTO and not args.goal:
        _exit_error("auto mode requires a goal: schematic review start --auto --goal \"<goal>\" --schematic <name>")
    base_ref = _run_git(["rev-parse", "HEAD"], project_root)[0]
    state = load_state(schematic_dir)
    state["run"] = {
        "mode": mode,
        "goal": args.goal,
        "base_ref": base_ref,
        "started_at": datetime.now(tz=timezone.utc).isoformat(),
    }
    save_state(schematic_dir, state)
    print(f"run started: mode={mode} base_ref={base_ref[:12]}")
    if mode == RUN_MODE_AUTO:
        print(f"  goal: {args.goal}")
        print("  MANDATE: record every decision the schematic doesn't answer, AT THE MOMENT IT'S MADE:")
        print(f"    schematic task decision <tag> \"<what> — <why>\" --schematic {args.schematic}")
        print("  drive the board; per-task reviews run diff-scoped as you go, then:")
        print(f"  schematic review sweep --schematic {args.schematic}")


_PYTHON_SUFFIX = ".py"


def _logic_line_count(python_source: str) -> int:
    """Physical lines of a Python file minus the lines its import statements occupy."""
    module = ast.parse(python_source)
    import_line_numbers: set[int] = set()
    for node in ast.walk(module):
        if isinstance(node, (ast.Import, ast.ImportFrom)):
            for line_number in range(node.lineno, (node.end_lineno or node.lineno) + 1):
                import_line_numbers.add(line_number)
    return len(python_source.splitlines()) - len(import_line_numbers)


def _oversized_feature_files(
    diff_files: list[str],
    project_root: Path,
    max_file_lines: int,
) -> dict[str, int]:
    """Python feature files whose logic-line count exceeds the ceiling → path-to-count."""
    path_to_logic_lines: dict[str, int] = {}
    for path in diff_files:
        if not path.endswith(_PYTHON_SUFFIX):
            continue
        file_path = project_root / path
        if not file_path.exists():
            continue
        logic_line_count = _logic_line_count(python_source=file_path.read_text())
        if logic_line_count > max_file_lines:
            path_to_logic_lines[path] = logic_line_count
    return path_to_logic_lines


def _print_oversized_files(
    path_to_logic_lines: dict[str, int],
    max_file_lines: int,
) -> None:
    """Surface feature files over the logic-line ceiling as consistency findings."""
    if not path_to_logic_lines:
        return
    print(f"⚠ {len(path_to_logic_lines)} file(s) over the {max_file_lines}-logic-line "
          f"ceiling (imports excluded) — split or justify each:")
    for path, logic_line_count in sorted(path_to_logic_lines.items()):
        print(f"    {path}: {logic_line_count} lines")


def _require_auto_run(state: dict, schematic_name: str) -> dict:
    """The recorded auto run, or exit — sweeps and review gates run only in auto mode."""
    run = state["run"]
    if not run or run["mode"] != RUN_MODE_AUTO:
        _exit_error(
            "no auto run recorded — start one first:\n"
            f"  schematic review start --auto --goal \"<goal>\" --schematic {schematic_name}"
        )
    return run


def _review_sweep(args: argparse.Namespace) -> None:
    schematic_dir = resolve_schematic_dir(args.schematic)
    project_root = find_project_root()
    review_model = _resolve_review_model(project_root)
    state = load_state(schematic_dir)
    run = _require_auto_run(state, args.schematic)
    diff_files = _cumulative_diff_files(run["base_ref"], project_root)
    if not diff_files:
        _exit_error(f"no changes since base_ref {run['base_ref'][:12]} — nothing to sweep")

    # Token efficiency: a file whose diff is byte-identical to one already reviewed
    # clean in a prior sweep needs no re-review — only re-touched files re-enter.
    file_to_diff = {
        path: _file_diff(path, run["base_ref"], project_root)
        for path in diff_files
    }
    clean_file_hashes = _clean_reviewed_file_hashes(state)
    files_to_review = [
        path for path in diff_files
        if _diff_hash(file_to_diff[path]) not in clean_file_hashes.get(path, set())
    ]
    skipped_clean = sorted(set(diff_files) - set(files_to_review))

    sweep_id = len(state["sweeps"]) + 1
    swept_milestone_id = _open_milestone_id(schematic_dir=schematic_dir, state=state)
    if not files_to_review:
        state["sweeps"].append({
            "sweep_id": sweep_id, "batches": [], "pristine": True,
            "skipped_clean": skipped_clean,
            "milestone": swept_milestone_id,
        })
        save_state(schematic_dir, state)
        print(f"sweep {sweep_id}: PRISTINE ✓ — all {len(skipped_clean)} changed file(s) "
              f"unchanged since their last clean review")
        print(f"  next: schematic review e2e --schematic {args.schematic}")
        return

    batches = _shard_diff_into_batches(files_to_review, MAX_FILES_PER_REVIEW_BATCH)
    sweep_record = {
        "sweep_id": sweep_id,
        "batches": [
            {
                "batch_id": f"{sweep_id}.{index + 1}",
                "files": batch,
                "file_hashes": {path: _diff_hash(file_to_diff[path]) for path in batch},
                "verdict": "pending",
                "summary": None,
            }
            for index, batch in enumerate(batches)
        ],
        "pristine": False,
        "skipped_clean": skipped_clean,
        "milestone": swept_milestone_id,
    }
    state["sweeps"].append(sweep_record)
    save_state(schematic_dir, state)

    batch_diffs = {
        batch["batch_id"]: "".join(file_to_diff[path] for path in batch["files"])
        for batch in sweep_record["batches"]
    }
    if skipped_clean:
        print(f"skipped {len(skipped_clean)} file(s) unchanged since last clean review: "
              f"{', '.join(skipped_clean)}")
    _emit_sweep_prompts(schematic_dir, sweep_record, batch_diffs, review_model)


def _emit_sweep_prompts(
    schematic_dir: Path,
    sweep_record: dict,
    batch_diffs: dict[str, str],
    review_model: str,
) -> None:
    batches = sweep_record["batches"]
    project_root = find_project_root()
    print(f"sweep {sweep_record['sweep_id']}: {len(batches)} batch(es) — diff-only style review "
          f"(≤{MAX_FILES_PER_REVIEW_BATCH} files each)")
    for batch in batches:
        diff_content = batch_diffs.get(batch["batch_id"], "")
        standards_content = _resolve_standards_content_for_batch(batch["files"], project_root)
        _emit_batch_review_prompt(schematic_dir, batch, diff_content, standards_content)
    print(f"\n  dispatch each batch as a {review_model} subagent, fix every finding, then record:")
    print(f"    schematic review batch-result <batch_id> clean|findings --summary \"<one line>\" "
          f"--schematic {schematic_dir.name}")
    print("  re-run `review sweep` after fixes; PRISTINE = a sweep where every batch is clean.")
    print("  run this sweep at each task-group boundary; once the board is drained and every group is")
    print("  PRISTINE: run `schematic review consistency --schematic <name>` for the single-pass dedup gate.")


def _diff_only_scope_and_body(diff_content: str, rule_three: str) -> str:
    """The two shared diff-only HARD RULES + a caller-specific rule 3 + the DIFF framing."""
    return (
        f"Scope (HARD RULES — violations are false flags + wasted tokens):\n"
        f"  1. Do NOT read, open, or grep ANY files. The diff below is your ONLY input.\n"
        f"  2. Flag ONLY lines that appear as added (+) or modified in the diff.\n"
        f"     Pre-existing/unchanged context lines are OUT of scope — never flag them.\n"
        f"  3. {rule_three}\n\n"
        f"── DIFF ──\n"
        f"{diff_content}\n"
        f"── END DIFF ──\n\n"
    )


def _emit_batch_review_prompt(
    schematic_dir: Path,
    batch: dict,
    diff_content: str,
    standards_content: str,
) -> None:
    file_list = "\n".join(f"    - {path}" for path in batch["files"])
    review_prompt = (
        f"Review batch {batch['batch_id']} — STYLE + STANDARDS review of these changes:\n"
        f"Files in this batch:\n"
        f"{file_list}\n\n"
    )
    review_prompt += _diff_only_scope_and_body(
        diff_content=diff_content,
        rule_three="Never flag or edit code outside the feature.",
    )

    if standards_content:
        review_prompt += (
            f"── STANDARDS (judge the diff against these) ──\n"
            f"{standards_content}\n"
            f"── END STANDARDS ──\n\n"
        )

    review_prompt += (
        f"Output: a numbered list of findings (file:line — issue — required fix), then a final\n"
        f"line: VERDICT: clean (zero findings) | VERDICT: findings\n"
    )
    print(f"\n  ── batch {batch['batch_id']} review prompt ──────────────────────")
    print(textwrap.indent(review_prompt, "  "))


def _review_batch_result(args: argparse.Namespace) -> None:
    schematic_dir = resolve_schematic_dir(args.schematic)
    state = load_state(schematic_dir)
    target_sweep = None
    target_batch = None
    for sweep in state["sweeps"]:
        for batch in sweep["batches"]:
            if batch["batch_id"] == args.batch_id:
                target_sweep = sweep
                target_batch = batch
    if target_batch is None:
        _exit_error(f"batch '{args.batch_id}' not found — run `schematic review sweep --schematic {args.schematic}` first")
    target_batch["verdict"] = args.verdict
    target_batch["summary"] = args.summary
    all_clean = all(b["verdict"] == REVIEW_VERDICT_CLEAN for b in target_sweep["batches"])
    target_sweep["pristine"] = all_clean
    save_state(schematic_dir, state)
    print(f"batch {args.batch_id}: {args.verdict} — {args.summary}")
    if all_clean:
        print(f"  sweep {target_sweep['sweep_id']}: PRISTINE ✓ — all {len(target_sweep['batches'])} batches clean")
    else:
        outstanding = [b["batch_id"] for b in target_sweep["batches"] if b["verdict"] != REVIEW_VERDICT_CLEAN]
        print(f"  sweep {target_sweep['sweep_id']}: not pristine — outstanding: {', '.join(outstanding)}")
        print(f"  fix findings, then re-run: schematic review sweep --schematic {args.schematic}")


def _review_consistency(args: argparse.Namespace) -> None:
    """Single-agent whole-diff consistency gate — duplication/redundancy + line-limit, after the sweeps are PRISTINE."""
    schematic_dir = resolve_schematic_dir(args.schematic)
    project_root = find_project_root()
    review_model = _resolve_review_model(project_root)
    state = load_state(schematic_dir)
    run = _require_auto_run(state, args.schematic)

    latest_sweep_is_pristine = bool(state["sweeps"]) and state["sweeps"][-1].get("pristine", False)
    if not latest_sweep_is_pristine:
        _exit_error(
            "latest sweep is not PRISTINE — re-sweep the outstanding group first:\n"
            f"  schematic review sweep --schematic {args.schematic}"
        )

    diff_files = _cumulative_diff_files(run["base_ref"], project_root)
    if not diff_files:
        _exit_error(f"no changes since base_ref {run['base_ref'][:12]} — nothing to review")

    state["consistency"] = {
        "status": REVIEW_GATE_STATUS_PENDING,
        "started_at": datetime.now(tz=timezone.utc).isoformat(),
        "verdict": None,
        "summary": None,
    }
    save_state(schematic_dir, state)

    max_file_lines = _resolve_max_file_lines(project_root=project_root)
    _print_oversized_files(
        path_to_logic_lines=_oversized_feature_files(
            diff_files=diff_files,
            project_root=project_root,
            max_file_lines=max_file_lines,
        ),
        max_file_lines=max_file_lines,
    )

    whole_diff = "".join(
        _file_diff(path, run["base_ref"], project_root)
        for path in diff_files
    )
    _emit_consistency_prompt(schematic_dir, diff_files, whole_diff, review_model)


def _emit_consistency_prompt(
    schematic_dir: Path,
    files: list[str],
    diff_content: str,
    review_model: str,
) -> None:
    file_list = "\n".join(f"  - {path}" for path in files)
    review_prompt = (
        f"Consistency review of the WHOLE feature diff in a single view — one pass, no loop.\n"
        f"Files:\n"
        f"{file_list}\n\n"
        f"Report ONLY these — standards, naming, typing and style were signed off per task and per group:\n"
        f"  - DUPLICATION: the same logic written twice ANYWHERE in the diff (two occurrences is\n"
        f"    the threshold), including structurally identical blocks with only names changed.\n"
        f"  - REDUNDANCY: a helper, constant, or type that restates another already in the diff.\n"
        f"  - SAID TWO WAYS: one concept named or patterned inconsistently across files.\n\n"
    )
    review_prompt += _diff_only_scope_and_body(
        diff_content=diff_content,
        rule_three="Never flag standards, naming, typing, or style — earlier gates own those.",
    )
    review_prompt += (
        f"Output: a numbered list of findings (file:line — what repeats — the unit to extract or\n"
        f"canonical form to keep), then a final line: VERDICT: clean | VERDICT: findings\n"
    )
    print(f"consistency review — ONE {review_model} subagent over the whole diff ({len(files)} files, single view):")
    print(textwrap.indent(review_prompt, "  "))
    print(f"  dispatch as ONE {review_model} subagent, triage findings, fix the accepted ones, then record")
    print("  (this pass does NOT loop — one read, triage, fix):")
    print(f"    schematic review consistency-result clean|findings --summary \"<one line>\" --schematic {schematic_dir.name}")
    print(f"  after clean: schematic review e2e --schematic {schematic_dir.name}")


def _review_consistency_result(args: argparse.Namespace) -> None:
    schematic_dir = resolve_schematic_dir(args.schematic)
    state = load_state(schematic_dir)
    consistency = state.get("consistency")
    if not consistency:
        _exit_error(
            f"no consistency gate recorded — run `schematic review consistency --schematic {args.schematic}` first"
        )
    consistency["status"] = args.verdict
    consistency["verdict"] = args.verdict
    consistency["summary"] = args.summary
    consistency["completed_at"] = datetime.now(tz=timezone.utc).isoformat()
    save_state(schematic_dir, state)
    print(f"consistency result: {args.verdict} — {args.summary}")
    if args.verdict == REVIEW_VERDICT_CLEAN:
        print(f"  consistency clean — next: schematic review e2e --schematic {args.schematic}")
    else:
        print("  fix the accepted findings, then re-run:")
        print(f"    schematic review consistency --schematic {args.schematic}")


def _review_e2e(args: argparse.Namespace) -> None:
    """Adversarial entry-point tracing gate — one correctness reviewer per entry point, after a clean consistency gate."""
    schematic_dir = resolve_schematic_dir(args.schematic)
    project_root = find_project_root()
    state = load_state(schematic_dir)
    run = _require_auto_run(state, args.schematic)

    # Verify the consistency gate passed.
    consistency = state.get("consistency")
    if not consistency or consistency.get("verdict") != REVIEW_VERDICT_CLEAN:
        _exit_error(
            "no clean consistency gate — run the consistency sweep first:\n"
            f"  schematic review consistency --schematic {args.schematic}"
        )

    diff_files = _cumulative_diff_files(run["base_ref"], project_root)
    if not diff_files:
        _exit_error(f"no changes since base_ref {run['base_ref'][:12]} — nothing to review")

    # Record e2e gate start.
    state["e2e"] = {
        "status": REVIEW_GATE_STATUS_PENDING,
        "started_at": datetime.now(tz=timezone.utc).isoformat(),
        "verdict": None,
        "summary": None,
    }
    save_state(schematic_dir, state)

    correctness_model = _resolve_correctness_model(project_root)
    model_label = correctness_model or "the session's planning model"
    pass_date = datetime.now(tz=timezone.utc).date().isoformat()
    pass_dir = f"research/correctness_pass_{pass_date}"

    file_list = "\n".join(f"  - {path}" for path in diff_files)
    print(f"e2e entry-point tracing — adversarial correctness gate over {len(diff_files)} changed files:")
    print(file_list)
    print()
    print("ORCHESTRATE the tracing pass — do NOT review inline:")
    print("  1. Enumerate every ENTRY POINT the feature adds or changes — HTTP routes, MCP tools,")
    print("     public service methods, any runner that applies files from a directory (migrations,")
    print("     seed scripts, jobs), the deploy subcommands, and the cron/scheduled/workflow entries")
    print("     (including pg_cron, Cloud Scheduler, terraform).")
    print(f"  2. Dispatch ONE {model_label} reviewer PER entry point, in parallel. Each traces its")
    print("     entry point end to end — to storage and back — against the ACs as the oracle, and")
    print("     MUST produce cross-path claims (what a DIFFERENT entry point now does as a result).")
    print("     Each reviewer carries the 7 checks: wiring, contracts, test coverage, integration,")
    print("     correctness, blast radius, and the meeting-point inventory table")
    print("     (state · writer file:line · reader file:line · axes · e2e test).")
    print(f"  3. One {model_label} reconciler dedupes, resolves contradictions, ranks by blast radius.")
    print(f"  4. Write {pass_dir}/ — R<n>_<entry_point>.md per reviewer, R_reconciled.md, R_dispositions.md.")
    print("  5. CORRECTNESS ONLY — the ACs and functional behaviour are the oracle. Style, naming and")
    print("     standards are never in scope here (the sweep and per-task reviews own them).")
    _print_decision_ledger(state)
    print()
    print("Findings are USER-DISPOSITIONED, never auto-fixed — including in auto mode. Present")
    print("R_reconciled.md and STOP; the user rules each finding (fix now / fix later / accept) into")
    print("R_dispositions.md. Record the reconciled verdict (never a silent fix):")
    print(f"  schematic review e2e-result clean|findings --summary \"<one line>\" --schematic {args.schematic}")


def _review_e2e_result(args: argparse.Namespace) -> None:
    schematic_dir = resolve_schematic_dir(args.schematic)
    state = load_state(schematic_dir)
    e2e = state.get("e2e")
    if not e2e:
        _exit_error(
            f"no e2e gate recorded — run `schematic review e2e --schematic {args.schematic}` first"
        )
    e2e["status"] = args.verdict
    e2e["verdict"] = args.verdict
    e2e["summary"] = args.summary
    e2e["completed_at"] = datetime.now(tz=timezone.utc).isoformat()
    save_state(schematic_dir, state)
    print(f"e2e result: {args.verdict} — {args.summary}")
    if args.verdict == REVIEW_VERDICT_CLEAN:
        print("  feature review complete — standards sweeps PRISTINE + consistency CLEAN + e2e tracing CLEAN.")
    else:
        print("  findings recorded — the user dispositions each in R_dispositions.md")
        print("  (fix now / fix later / accept); re-run only after fixes the user chose to action:")
        print(f"    schematic review e2e --schematic {args.schematic}")


def _review_status(args: argparse.Namespace) -> None:
    schematic_dir = resolve_schematic_dir(args.schematic)
    state = load_state(schematic_dir)
    run = state["run"]
    if not run:
        print(f"no run recorded — schematic review start --schematic {args.schematic}")
        return
    print(f"mode: {run['mode']}  base_ref: {run['base_ref'][:12]}")
    if run["goal"]:
        print(f"goal: {run['goal']}")
    if not state["sweeps"]:
        print("sweeps: none yet")
        return
    latest_sweep = state["sweeps"][-1]
    pristine_flag = "PRISTINE ✓" if latest_sweep["pristine"] else "not pristine"
    print(f"latest sweep {latest_sweep['sweep_id']}: {pristine_flag} ({len(latest_sweep['batches'])} batches)")
    for batch in latest_sweep["batches"]:
        print(f"  {batch['batch_id']:<6} {batch['verdict']:<9} [{', '.join(batch['files'])}]")
    consistency = state.get("consistency")
    if consistency:
        consistency_flag = "CLEAN ✓" if consistency.get("verdict") == REVIEW_VERDICT_CLEAN else consistency.get("status", "pending")
        print(f"consistency: {consistency_flag}")
        if consistency.get("summary"):
            print(f"  {consistency['summary']}")
    e2e = state.get("e2e")
    if e2e:
        e2e_flag = "CLEAN ✓" if e2e.get("verdict") == REVIEW_VERDICT_CLEAN else e2e.get("status", "pending")
        print(f"e2e correctness: {e2e_flag}")
        if e2e.get("summary"):
            print(f"  {e2e['summary']}")


# ── track (lazy-loaded) ───────────────────────────────────────────────────────

def cmd_track(args: argparse.Namespace) -> None:
    import importlib.util
    script_dir = Path(__file__).resolve().parent
    spec = importlib.util.spec_from_file_location("track", script_dir / "track.py")
    if spec is None or spec.loader is None:
        _exit_error("track.py not found — skill may be corrupted")
    track_mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(track_mod)

    schematic_dir = resolve_schematic_dir(args.schematic)
    if args.track_command == "init":
        track_mod.cmd_track_init(
            schematic_dir=schematic_dir,
            entry=args.entry,
            trace_name=args.trace,
        )
    elif args.track_command == "validate":
        track_mod.cmd_track_validate(
            schematic_dir=schematic_dir,
            trace_name=getattr(args, "trace", None),
        )
    elif args.track_command == "show":
        track_mod.cmd_track_show(
            schematic_dir=schematic_dir,
            trace_name=getattr(args, "trace", None),
        )


# ── overview (lazy-loaded) ────────────────────────────────────────────────────

def cmd_overview(args: argparse.Namespace) -> None:
    import importlib.util
    script_dir = Path(__file__).resolve().parent
    spec = importlib.util.spec_from_file_location("overview", script_dir / "overview.py")
    if spec is None or spec.loader is None:
        _exit_error("overview.py not found — skill may be corrupted")
    overview_mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(overview_mod)

    if args.name:
        schematic_dir = resolve_schematic_dir(args.name)
    else:
        dirs = list_schematic_dirs()
        if not dirs:
            _exit_error("no schematics found")
        schematic_dir = dirs[-1]

    overview_mod.launch_overview(schematic_dir, args.fragment)

# ── roster command (topology present gate) ──────────────────────────────────────

@dataclass(frozen=True)
class LaunchedEditor:
    pid: int
    url: str


def _skill_root() -> Path:
    """The schematic skill root (scripts/ lives one level below it)."""
    return Path(__file__).resolve().parent.parent


def cmd_roster(args: argparse.Namespace) -> None:
    roster_handlers = {
        "init": _roster_init,
        "present": _roster_present,
    }
    roster_handlers[args.roster_command](args)


def _roster_init(args: argparse.Namespace) -> None:
    """Scaffold a blank skeleton roster.mmd from Phase-1 features (if absent), then launch the editor immediately."""
    schematic_dir = resolve_schematic_dir(args.schematic)
    canonical_path = schematic_dir / ROSTER_FILENAME
    if not canonical_path.exists():
        feature_strips = parse_feature_strips(
            objective_md=schematic_dir / "objective.md",
        )
        if not feature_strips:
            _exit_error(
                "no Phase-1 features found in objective.md — lock Phase 1 before the roster",
            )
        canonical_path.write_text(
            _render_roster_skeleton(features=feature_strips),
        )

    skeleton_findings = _validate_mermaid_file(canonical_path)
    if skeleton_findings:
        _exit_error(
            f"roster did not validate — nothing launched: {canonical_path} — {skeleton_findings}",
        )

    nonce = secrets.token_hex(ROSTER_NONCE_BYTES)
    launched_editor = _launch_roster_editor(
        canonical_path=canonical_path,
        schematic_dir=schematic_dir,
    )
    _record_roster_presented(
        schematic_dir=schematic_dir,
        num=args.num,
        nonce=nonce,
        launched_editor=launched_editor,
        canonical_path=canonical_path,
    )
    print(
        _render_roster_envelope(
            name=args.schematic,
            num=args.num,
            nonce=nonce,
            launched_editor=launched_editor,
            canonical_path=canonical_path,
        ),
    )


def _render_roster_skeleton(features: list[FeatureStrip]) -> str:
    """A valid-but-blank roster: one placeholder subgraph per feature, dark-mode classDefs, for the agent to fill."""
    subgraph_blocks = [
        _render_skeleton_subgraph(feature=feature)
        for feature in features
    ]
    feature_chain = " ~~~ ".join(
        f"F{feature.number}"
        for feature in features
    )
    document_sections = [
        "flowchart TB",
        "\n\n".join(subgraph_blocks),
        feature_chain,
        ROSTER_SKELETON_CLASSDEFS,
    ]
    return "\n\n".join(
        section
        for section in document_sections
        if section
    ) + "\n"


def _render_skeleton_subgraph(feature: FeatureStrip) -> str:
    ac_tags_label = " ".join(feature.ac_tags)
    quote_free_title = feature.title.replace('"', "")
    return "\n".join(
        [
            f'  subgraph F{feature.number}["F{feature.number} · {quote_free_title} ({ac_tags_label})"]',
            "    direction TB",
            f'    F{feature.number}_todo["{ROSTER_SKELETON_TODO_LABEL}"]',
            "  end",
        ],
    )


def _roster_present(args: argparse.Namespace) -> None:
    schematic_dir = resolve_schematic_dir(args.schematic)
    draft_path = args.file
    if not draft_path.exists():
        _exit_error(f"draft roster not found: {draft_path}")

    draft_findings = _validate_mermaid_file(draft_path)
    if draft_findings:
        print(f"⚠️  draft does not validate — nothing launched, nothing written: {draft_path}")
        for finding in draft_findings:
            print(f"   {finding}")
        sys.exit(1)

    canonical_path = schematic_dir / ROSTER_FILENAME
    canonical_path.write_text(draft_path.read_text())

    nonce = secrets.token_hex(ROSTER_NONCE_BYTES)
    launched_editor = _launch_roster_editor(
        canonical_path=canonical_path,
        schematic_dir=schematic_dir,
    )
    _record_roster_presented(
        schematic_dir=schematic_dir,
        num=args.num,
        nonce=nonce,
        launched_editor=launched_editor,
        canonical_path=canonical_path,
    )
    print(
        _render_roster_envelope(
            name=args.schematic,
            num=args.num,
            nonce=nonce,
            launched_editor=launched_editor,
            canonical_path=canonical_path,
        ),
    )


def _launch_roster_editor(
    canonical_path: Path,
    schematic_dir: Path,
) -> LaunchedEditor:
    """Spawn the live editor detached (survives this CLI); fail closed if it never opens."""
    bridge_path = _skill_root() / BRIDGE_RELPATH
    if not bridge_path.exists():
        _exit_error(f"editor bridge missing: {bridge_path}")

    editor_log_path = schematic_dir / ROSTER_EDITOR_LOG
    editor_process = subprocess.Popen(
        ["python3", str(bridge_path), str(canonical_path)],
        stdout=editor_log_path.open("w"),
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    return LaunchedEditor(
        pid=editor_process.pid,
        url=_await_editor_url(
            editor_log_path=editor_log_path,
            editor_process=editor_process,
            url_prefix=EDITOR_URL_LOG_PREFIX,
        ),
    )


def _polled_ui_url(
    editor_log_path: Path,
    editor_process: "subprocess.Popen[bytes]",
    url_prefix: str,
) -> str | None:
    """The URL a launched UI logs — None when it exits first or stays silent past the timeout."""
    deadline = time.monotonic() + EDITOR_LAUNCH_TIMEOUT_SECONDS
    while time.monotonic() < deadline:
        if editor_process.poll() is not None:
            return None
        reported_url = _editor_url_in_log(
            editor_log_path=editor_log_path,
            url_prefix=url_prefix,
        )
        if reported_url is not None:
            return reported_url
        time.sleep(EDITOR_URL_POLL_SECONDS)
    return None


def _await_editor_url(
    editor_log_path: Path,
    editor_process: "subprocess.Popen[bytes]",
    url_prefix: str,
) -> str:
    """The URL a launched UI logs; fail closed when it never reports one."""
    reported_url = _polled_ui_url(
        editor_log_path=editor_log_path,
        editor_process=editor_process,
        url_prefix=url_prefix,
    )
    if reported_url is not None:
        return reported_url
    if editor_process.poll() is not None:
        _exit_error(
            f"editor exited before opening (code {editor_process.returncode}) "
            f"— nothing presented; see {editor_log_path}",
        )
    _exit_error(
        f"editor did not report a URL within {EDITOR_LAUNCH_TIMEOUT_SECONDS:.0f}s "
        f"— nothing presented; see {editor_log_path}",
    )


def _editor_url_in_log(editor_log_path: Path, url_prefix: str) -> str | None:
    if not editor_log_path.exists():
        return None
    for log_line in editor_log_path.read_text().splitlines():
        if log_line.startswith(url_prefix):
            return log_line[len(url_prefix):].strip()
    return None


def _record_roster_presented(
    schematic_dir: Path,
    num: int,
    nonce: str,
    launched_editor: LaunchedEditor,
    canonical_path: Path,
) -> None:
    state = load_state(schematic_dir)
    state["phases"].setdefault(str(num), {})["roster"] = {
        "presented_at": datetime.now(tz=timezone.utc).isoformat(),
        "nonce": nonce,
        "editor_url": launched_editor.url,
        "editor_pid": launched_editor.pid,
        "file": str(canonical_path.relative_to(find_project_root())),
    }
    save_state(schematic_dir, state)


def _render_roster_envelope(
    name: str,
    num: int,
    nonce: str,
    launched_editor: LaunchedEditor,
    canonical_path: Path,
) -> str:
    watcher_command = f"python3 {_skill_root() / WATCHER_RELPATH} {canonical_path}"
    return textwrap.dedent(
        """\
        Paste the fenced envelope below verbatim into your message to the user — the
        nonce is the proof this launcher ran. The editor canvas is the ONLY roster
        surface: do NOT post the topology (strips, node list, ASCII) in chat. Arm the
        watcher (backgrounded), then point the user at the live editor.

        ⟦schematic·roster present={num} nonce={nonce} editor={url}⟧
        ── SCHEMATIC {name} · PHASE {num}/9 — Topology ─────────────────────────
        This gate: the ROSTER — the full class + storage set — is LIVE in the editor.
        EDITOR LIVE ▸ {url}
        Edit nodes there (rename / kill / add), then Save & Close.
        Q&A watcher (arm backgrounded):
          {watcher}
        ────────────────────────────────────────────────────────────────────────
        ⟦/schematic·roster nonce={nonce}⟧   Confirm: y/comment"""
    ).format(
        num=num,
        nonce=nonce,
        url=launched_editor.url,
        name=name,
        watcher=watcher_command,
    )

# ── argparse + dispatch ───────────────────────────────────────────────────────

def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="schematic", description="Schematic planning workflow CLI")
    sub = parser.add_subparsers(dest="command", required=True)

    p_init = sub.add_parser("init", help="Scaffold a new schematic directory")
    p_init.add_argument("name", help="Feature name (kebab-case)")

    p_status = sub.add_parser("status", help="Show task progress")
    p_status.add_argument("name", nargs="?", help="Schematic name (omit for all)")

    p_validate = sub.add_parser("validate", help="AC pyramid + cross-ref integrity check")
    p_validate.add_argument("name", nargs="?", help="Schematic name (omit for all)")

    p_mermaid = sub.add_parser("mermaid", help="Validate .mmd diagram files")
    p_mermaid.add_argument("name", nargs="?", help="Schematic name")
    p_mermaid.add_argument("--file", type=Path, help="Specific .mmd file path")

    p_phase = sub.add_parser("phase", help="Phase lifecycle commands")
    phase_sub = p_phase.add_subparsers(dest="phase_command", required=True)

    p_pa = phase_sub.add_parser("audit", help="Record audit result for a phase")
    p_pa.add_argument("num", type=int, choices=sorted(PHASES_REQUIRING_AUDIT))
    p_pa.add_argument("result", help="'clean' or findings description")
    p_pa.add_argument("--schematic", required=True, metavar="NAME")

    p_ps = phase_sub.add_parser("sign-off", help="Record user sign-off for a phase")
    p_ps.add_argument("num", type=int, choices=sorted(VALID_PHASES))
    p_ps.add_argument("--schematic", required=True, metavar="NAME")

    p_pc = phase_sub.add_parser("complete", help="Lock a phase (enforces audit + sign-off)")
    p_pc.add_argument("num", type=int, choices=sorted(VALID_PHASES))
    p_pc.add_argument("--schematic", required=True, metavar="NAME")
    p_pc.add_argument("--override", metavar="REASON", help="Bypass enforcement with reason")

    p_roster = sub.add_parser("roster", help="Topology roster gate (Phase 2)")
    roster_sub = p_roster.add_subparsers(dest="roster_command", required=True)
    p_rinit = roster_sub.add_parser(
        "init",
        help="Scaffold a blank skeleton roster.mmd from Phase-1 features and launch the editor immediately",
    )
    p_rinit.add_argument("num", type=int, choices=[ROSTER_PHASE])
    p_rinit.add_argument("--schematic", required=True, metavar="NAME")
    p_rpresent = roster_sub.add_parser(
        "present",
        help="Validate a draft roster, write canonical roster.mmd, launch the editor, emit the stamped gate envelope",
    )
    p_rpresent.add_argument("num", type=int, choices=[ROSTER_PHASE])
    p_rpresent.add_argument("--schematic", required=True, metavar="NAME")
    p_rpresent.add_argument(
        "--file",
        type=Path,
        required=True,
        help="Draft .mmd authored by the agent; validated, then written to roster.mmd on success",
    )

    p_task = sub.add_parser("task", help="Task lifecycle commands")
    task_sub = p_task.add_subparsers(dest="task_command", required=True)

    p_tshow = task_sub.add_parser("show", help="Flatten task + component context for agent handoff")
    p_tshow.add_argument("tag", help="Task tag e.g. b.1")
    p_tshow.add_argument("--schematic", required=True, metavar="NAME")

    p_tstat = task_sub.add_parser("status", help="Update task status")
    p_tstat.add_argument("tag")
    p_tstat.add_argument("status", choices=MANUAL_TASK_STATUS_CHOICES)
    p_tstat.add_argument("--schematic", required=True, metavar="NAME")
    p_tstat.add_argument("--override", metavar="REASON", help="Bypass legal transition check")

    p_tcomp = task_sub.add_parser("complete", help="Mark task complete (requires clean review)")
    p_tcomp.add_argument("tag")
    p_tcomp.add_argument("--schematic", required=True, metavar="NAME")
    p_tcomp.add_argument("--override", metavar="REASON", help="Bypass status + clean-review checks")

    p_trev = task_sub.add_parser("review-result", help="Record the review verdict for a task")
    p_trev.add_argument("tag", help="Task tag (e.g. b.1)")
    p_trev.add_argument("verdict", choices=sorted(REVIEW_VERDICTS))
    p_trev.add_argument("--summary", required=True, help="One-line review outcome")
    p_trev.add_argument("--schematic", required=True, metavar="NAME")

    p_tnext = task_sub.add_parser("next", help="Show next unblocked pending task and claim it")
    p_tnext.add_argument("name", nargs="?", help="Schematic name (omit for all)")
    p_tnext.add_argument("--peek", action="store_true", help="Show without claiming (no status transition)")

    p_tnote = task_sub.add_parser("note", help="Add agent note to a task")
    p_tnote.add_argument("tag", help="Task tag (e.g. a.1)")
    p_tnote.add_argument("text", help="Note text")
    p_tnote.add_argument("--schematic", required=True, metavar="NAME")

    p_task_ask = task_sub.add_parser(
        "ask",
        help="Ask the user a question the design doesn't answer; holds the task in pendingInput",
    )
    p_task_ask.add_argument("tag", help="Task tag (e.g. a.1)")
    p_task_ask.add_argument("text", help='The question: "<one sentence> — why: <what is blocked>"')
    p_task_ask.add_argument("--schematic", required=True, metavar="NAME")

    p_tdecision = task_sub.add_parser(
        "decision",
        help="Record a non-contract choice the schematic didn't answer "
             "(naming/placement only — anything heavier is `task ask`)",
    )
    p_tdecision.add_argument("tag", help="Task tag (e.g. a.1)")
    p_tdecision.add_argument("text", help='Decision text: "<what was decided> — <why it was needed>"')
    p_tdecision.add_argument(
        "--kind",
        required=True,
        metavar="KIND",
        help="naming | placement — a contract change, caveat, or unspecified value must use `task ask`",
    )
    p_tdecision.add_argument("--schematic", required=True, metavar="NAME")

    p_milestone = sub.add_parser(
        "milestone",
        help="Multi-stage delivery: the Phase-7 decision + the Phase-8 boundary gate",
    )
    milestone_sub = p_milestone.add_subparsers(dest="milestone_command", required=True)

    p_mdecide = milestone_sub.add_parser(
        "decide",
        help="Record the Phase-7 answer: split this task set into milestones?",
    )
    p_mdecide.add_argument("answer", choices=sorted(VALID_MILESTONE_DECISIONS))
    p_mdecide.add_argument("--schematic", required=True, metavar="NAME")

    p_mpropose = milestone_sub.add_parser(
        "propose",
        help="Validate the ## Milestones table and present the resolved membership for the gate",
    )
    p_mpropose.add_argument("--schematic", required=True, metavar="NAME")

    p_mlock = milestone_sub.add_parser("lock", help="Lock the proposed milestones on the user's y")
    p_mlock.add_argument("--schematic", required=True, metavar="NAME")

    p_mstatus = milestone_sub.add_parser(
        "status",
        help="Per-milestone task counts, gate state, and which milestone is open",
    )
    p_mstatus.add_argument("--schematic", required=True, metavar="NAME")

    p_msignoff = milestone_sub.add_parser(
        "sign-off",
        help="Sign a drained milestone off (opens the next one)",
    )
    p_msignoff.add_argument("id", metavar="MILESTONE", help="Milestone id (e.g. M1)")
    p_msignoff.add_argument("--schematic", required=True, metavar="NAME")

    p_mreport = milestone_sub.add_parser(
        "report",
        help="Write the milestone's section of implementation_report.md and print it",
    )
    p_mreport.add_argument("id", metavar="MILESTONE", help="Milestone id (e.g. M1)")
    p_mreport.add_argument("--schematic", required=True, metavar="NAME")
    p_mreport.add_argument(
        "--suite",
        metavar="LAST_LINES",
        help="The test suite's last line(s) as run for this milestone",
    )

    p_mamend = milestone_sub.add_parser(
        "amend",
        help="Post-lock re-scope: move tasks between milestones, or add one",
    )
    p_mamend.add_argument("--schematic", required=True, metavar="NAME")
    p_mamend.add_argument("--reason", required=True, metavar="WHY", help="Why the scope changed")
    p_mamend.add_argument("--move", metavar="TAGS", help="Comma-separated task tags to move")
    p_mamend.add_argument("--to", metavar="MILESTONE", help="Destination milestone id for --move")
    p_mamend.add_argument("--add", metavar="MILESTONE", help="New milestone id to append")
    p_mamend.add_argument("--title", metavar="TITLE", help="Title for --add")
    p_mamend.add_argument("--scope", metavar="SCOPE", help="Comma-separated groups/tags for --add")
    p_mamend.add_argument("--proves", metavar="TEXT", help="What --add proves")

    p_review = sub.add_parser("review", help="Auto-mode driver + per-group standards sweep + consistency + e2e tracing")
    review_sub = p_review.add_subparsers(dest="review_command", required=True)

    p_rstart = review_sub.add_parser("start", help="Record run mode + base ref (HEAD)")
    p_rstart.add_argument("--schematic", required=True, metavar="NAME")
    p_rstart.add_argument("--auto", action="store_true", help="Auto mode (omit for manual)")
    p_rstart.add_argument("--goal", help="Long-running goal (required in auto mode)")

    p_rsweep = review_sub.add_parser("sweep", help="Shard the cumulative diff into <=5-file review batches")
    p_rsweep.add_argument("--schematic", required=True, metavar="NAME")

    p_rresult = review_sub.add_parser("batch-result", help="Record a batch verdict; flags PRISTINE when all clean")
    p_rresult.add_argument("batch_id", help="Batch id (e.g. 1.2)")
    p_rresult.add_argument("verdict", choices=sorted(REVIEW_VERDICTS))
    p_rresult.add_argument("--summary", required=True, help="One-line batch outcome")
    p_rresult.add_argument("--schematic", required=True, metavar="NAME")

    p_rconsistency = review_sub.add_parser("consistency", help="Single-agent whole-diff consistency gate (after PRISTINE sweeps)")
    p_rconsistency.add_argument("--schematic", required=True, metavar="NAME")

    p_rconsistency_result = review_sub.add_parser("consistency-result", help="Record consistency verdict")
    p_rconsistency_result.add_argument("verdict", choices=sorted(REVIEW_VERDICTS))
    p_rconsistency_result.add_argument("--summary", required=True, help="One-line consistency outcome")
    p_rconsistency_result.add_argument("--schematic", required=True, metavar="NAME")

    p_re2e = review_sub.add_parser("e2e", help="Entry-point tracing gate (after clean consistency)")
    p_re2e.add_argument("--schematic", required=True, metavar="NAME")

    p_re2e_result = review_sub.add_parser("e2e-result", help="Record e2e correctness verdict")
    p_re2e_result.add_argument("verdict", choices=sorted(REVIEW_VERDICTS))
    p_re2e_result.add_argument("--summary", required=True, help="One-line e2e outcome")
    p_re2e_result.add_argument("--schematic", required=True, metavar="NAME")

    p_rstatus = review_sub.add_parser("status", help="Show run mode + latest sweep batch verdicts")
    p_rstatus.add_argument("--schematic", required=True, metavar="NAME")

    p_track = sub.add_parser("track", help="Trace a feature flow E2E")
    track_sub = p_track.add_subparsers(dest="track_command", required=True)

    p_track_init = track_sub.add_parser("init", help="Scaffold trace directory for a flow")
    p_track_init.add_argument("--schematic", required=True, metavar="NAME")
    p_track_init.add_argument("--entry", required=True, help="Entry point (file:line, class, or route)")
    p_track_init.add_argument("--trace", required=True, metavar="TRACE_NAME", help="Trace name (kebab-case)")

    p_track_validate = track_sub.add_parser("validate", help="Validate trace output files")
    p_track_validate.add_argument("--schematic", required=True, metavar="NAME")
    p_track_validate.add_argument("--trace", metavar="TRACE_NAME", help="Validate a single trace (omit for all)")

    p_track_show = track_sub.add_parser("show", help="Display trace summary")
    p_track_show.add_argument("--schematic", required=True, metavar="NAME")
    p_track_show.add_argument("--trace", metavar="TRACE_NAME", help="Show a single trace (omit for summary)")

    p_overview = sub.add_parser("overview", help="Launch schematic overview browser")
    p_overview.add_argument("name", nargs="?", help="Schematic name (omit for current)")
    p_overview.add_argument(
        "--fragment",
        default="",
        metavar="HASH",
        help="Open on a specific screen (e.g. milestone:M2, reports, kanban)",
    )

    p_questions = sub.add_parser("questions", help="List unanswered dashboard/editor questions")
    p_questions.add_argument("name", nargs="?", help="Schematic name (omit for all)")

    p_answer = sub.add_parser("answer", help="Answer a dashboard/editor question (UI picks it up live)")
    p_answer.add_argument("id", help="Question id from `schematic questions` (e.g. overview#0, sequence#2)")
    p_answer.add_argument("text", help="Answer text shown in the dashboard bubble")
    p_answer.add_argument("name", nargs="?", help="Schematic name (omit to search all)")

    p_setup = sub.add_parser("setup", help="Wire PostToolUse validation hook into .claude/settings.json")
    p_setup.add_argument("--install", action="store_true", help="Write hook (omit for dry run)")

    return parser


def dispatch(args: argparse.Namespace) -> None:
    handlers = {
        "init": cmd_init,
        "setup": cmd_setup,
        "status": cmd_status,
        "validate": cmd_validate,
        "mermaid": cmd_mermaid,
        "phase": cmd_phase,
        "roster": cmd_roster,
        "task": cmd_task,
        "milestone": cmd_milestone,
        "review": cmd_review,
        "track": cmd_track,
        "overview": cmd_overview,
        "questions": cmd_questions,
        "answer": cmd_answer,
    }
    handlers[args.command](args)  # type: ignore[operator]


def main() -> None:
    dispatch(_build_parser().parse_args())


if __name__ == "__main__":
    main()
