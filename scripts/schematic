REVIEW_MODEL_KEY = "reviewModel"
CORRECTNESS_MODEL_KEY = "correctnessModel"
CORRECTNESS_MODEL_INHERIT_LABEL = "inherit"  # unset = the session's planning model, never reviewModel
SCHEMATIC_CONFIG_KEY = "schematic"
REVIEW_VERDICT_CLEAN = "clean"
REVIEW_VERDICT_FINDINGS = "findings"
REVIEW_VERDICTS = {REVIEW_VERDICT_CLEAN, REVIEW_VERDICT_FINDINGS}
REVIEW_GATE_STATUS_PENDING = "pending"  # a consistency/e2e gate opened but not yet recorded

MAX_FILES_PER_REVIEW_BATCH = 5  # token bound: a sweep subagent reads at most this many files, nothing else
MAX_FILE_LINES_KEY = "maxFileLines"
MAX_FILE_LINES_DEFAULT = 220  # per-file logic lines, imports excluded — the styling standard
RUN_MODE_MANUAL = "manual"  # per-task sketch gate (default)
RUN_MODE_AUTO = "auto"      # long-running driver loop + per-group standards sweep + consistency + e2e tracing
VALID_RUN_MODES = {RUN_MODE_MANUAL, RUN_MODE_AUTO}
