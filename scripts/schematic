# ── file discovery ─────────────────────────────────────────────────────────────

def find_project_root() -> Path:
    current = Path.cwd()
    while current != current.parent:
        if (current / SCHEMATICS_BASE).exists() or (current / ".git").exists():
            return current
        current = current.parent
    return Path.cwd()


def resolve_schematic_dir(name: str) -> Path:
    path = find_project_root() / SCHEMATICS_BASE / name
    if not path.exists():
        _exit_error(f"schematic '{name}' not found at {path}")
    return path


def list_schematic_dirs() -> list[Path]:
    base = find_project_root() / SCHEMATICS_BASE
    if not base.exists():
        return []
    return sorted(
        p for p in base.iterdir()
        if p.is_dir() and p.name != ARCHIVE_SUBDIR
    )

# ── state I/O ──────────────────────────────────────────────────────────────────

def load_state(schematic_dir: Path) -> dict:
    state_path = schematic_dir / STATE_FILENAME
    if not state_path.exists():
        return {
            "phases": {}, "tasks": {}, "overrides": [],
            "run": None, "sweeps": [], "milestones": None,
        }
    loaded_state = json.loads(state_path.read_text())
    loaded_state.setdefault("run", None)
    loaded_state.setdefault("sweeps", [])
    loaded_state.setdefault("milestones", None)
    return loaded_state


def save_state(schematic_dir: Path, state: dict) -> None:
    (schematic_dir / STATE_FILENAME).write_text(json.dumps(state, indent=2) + "\n")


def record_override(state: dict, context: str, reason: str) -> None:
    state["overrides"].append({
        "context": context,
        "reason": reason,
        "at": datetime.now(tz=timezone.utc).isoformat(),
    })

# ── diff collection ──────────────────────────────────────────────────────────────

def _run_git(git_args: list[str], project_root: Path) -> list[str]:
    """Run a git command in project_root; return non-empty stdout lines."""
    completed = subprocess.run(
        ["git", *git_args],
        cwd=project_root,
        capture_output=True,
        text=True,
    )
    if completed.returncode != 0:
        _exit_error(f"git {' '.join(git_args)} failed: {completed.stderr.strip()}")
    return [line.strip() for line in completed.stdout.splitlines() if line.strip()]


def _run_git_raw(git_args: list[str], project_root: Path) -> str:
    """Run a git command in project_root; return raw stdout."""
    completed = subprocess.run(
        ["git", *git_args],
        cwd=project_root,
        capture_output=True,
        text=True,
    )
    if completed.returncode != 0:
        _exit_error(f"git {' '.join(git_args)} failed: {completed.stderr.strip()}")
    return completed.stdout


def _cumulative_diff_files(base_ref: str, project_root: Path) -> list[str]:
    """Feature files changed since base_ref — tracked diffs plus new untracked, minus schematic planning artifacts."""
    tracked_changed = _run_git(["diff", "--name-only", base_ref], project_root)
    untracked_new = _run_git(["ls-files", "--others", "--exclude-standard"], project_root)
    all_changed = set(tracked_changed) | set(untracked_new)
    return sorted(path for path in all_changed if not path.startswith(SCHEMATICS_BASE + "/"))


def _file_diff(path: str, base_ref: str, project_root: Path) -> str:
    """Diff hunks for one file since base_ref; untracked files render as fully-added hunks."""
    tracked = _run_git_raw(["diff", base_ref, "--", path], project_root)
    if tracked:
        return tracked
    # `git diff base_ref` is empty for untracked files — synthesize the all-added diff.
    completed = subprocess.run(
        ["git", "diff", "--no-index", "--", "/dev/null", path],
        cwd=project_root,
        capture_output=True,
        text=True,
    )
    return completed.stdout


def _diff_hash(diff_content: str) -> str:
    return hashlib.sha256(diff_content.encode("utf-8")).hexdigest()


def _clean_reviewed_file_hashes(state: dict) -> dict[str, set[str]]:
    """Per file: the diff hashes that already passed a clean batch review in any prior sweep."""
    path_to_hashes: dict[str, set[str]] = {}
    for sweep in state.get("sweeps", []):
        for batch in sweep.get("batches", []):
            if batch.get("verdict") != REVIEW_VERDICT_CLEAN:
                continue
            for path, diff_hash in batch.get("file_hashes", {}).items():
                path_to_hashes.setdefault(path, set()).add(diff_hash)
    return path_to_hashes


def _shard_diff_into_batches(changed_files: list[str], max_files_per_batch: int) -> list[list[str]]:
    """Split changed files into ordered batches of at most max_files_per_batch each."""
    return [
        changed_files[start : start + max_files_per_batch]
        for start in range(0, len(changed_files), max_files_per_batch)
    ]


def _locate_standards_manifest(project_root: Path) -> Path | None:
    """First manifest in the lookup chain: repo .schematic/ → repo .claude/ → user .schematic/ → user .claude/."""
    manifest_paths = (
        project_root / STANDARDS_MANIFEST_RELPATH_CANONICAL,
        project_root / STANDARDS_MANIFEST_RELPATH,
        Path.home() / STANDARDS_MANIFEST_RELPATH_CANONICAL,
        Path.home() / STANDARDS_MANIFEST_RELPATH,
    )
    for manifest_path in manifest_paths:
        if manifest_path.exists():
            return manifest_path
    return None


def _load_standards_manifest(project_root: Path) -> dict:
    """The resolved standards manifest, or empty when the lookup chain finds none."""
    manifest_path = _locate_standards_manifest(project_root)
    if manifest_path is None:
        return {}
    return json.loads(manifest_path.read_text())


def _resolve_review_model(project_root: Path) -> str:
    """Review model from manifest's schematic.reviewModel, else default."""
    manifest = _load_standards_manifest(project_root)
    schematic_config = manifest.get(SCHEMATIC_CONFIG_KEY, {})
    return schematic_config.get(REVIEW_MODEL_KEY, REVIEW_MODEL_DEFAULT)


def _resolve_correctness_model(project_root: Path) -> str | None:
    """Pass-3 correctness model from schematic.correctnessModel; None means inherit the session model."""
    manifest = _load_standards_manifest(project_root)
    schematic_config = manifest.get(SCHEMATIC_CONFIG_KEY, {})
    correctness_model: str | None = schematic_config.get(CORRECTNESS_MODEL_KEY)
    return correctness_model


def _resolve_max_file_lines(project_root: Path) -> int:
    """Per-file logic-line ceiling from schematic.maxFileLines, else the packaged default."""
    manifest = _load_standards_manifest(project_root)
    schematic_config = manifest.get(SCHEMATIC_CONFIG_KEY, {})
    return schematic_config.get(MAX_FILE_LINES_KEY, MAX_FILE_LINES_DEFAULT)


def _resolve_source_path(source: str, project_root: Path) -> Path | None:
    """Resolve a manifest source ('skill:<name>' or 'file:<path>') to a readable path."""
    if source.startswith("skill:"):
        return _resolve_skill_path(source)
    if source.startswith("file:"):
        raw_path = Path(source[len("file:"):]).expanduser()
        candidate = raw_path if raw_path.is_absolute() else project_root / raw_path
        return candidate if candidate.exists() else None
    return None


def _resolve_mapped_source_paths(slot: str, sources: list[str], project_root: Path) -> list[Path]:
    """Resolve every source mapped to a slot, in order; a mapped module missing from disk refuses the manifest."""
    resolved_paths: list[Path] = []
    for source in sources:
        path = _resolve_source_path(
            source=source,
            project_root=project_root,
        )
        if path is None:
            _exit_error(
                f"standards manifest slot '{slot}' names a source that is not on disk: '{source}'\n"
                f"  map it to a module that exists, or drop the slot to leave it UNMAPPED"
            )
        else:
            resolved_paths.append(path)
    return resolved_paths


def _resolved_slot_paths(project_root: Path) -> dict[str, list[Path]]:
    """Every mapped manifest slot resolved to its ordered module paths (styling flattened per language)."""
    manifest = _load_standards_manifest(project_root)
    slot_to_paths: dict[str, list[Path]] = {}
    for slot in STANDARDS_SLOTS:
        source = manifest.get(slot)
        if slot == EXEMPLARS_SLOT:
            continue
        if slot == STYLING_SLOT and isinstance(source, dict):
            for lang, lang_source in source.items():
                slot_to_paths[f"styling.{lang}"] = _resolve_mapped_source_paths(
                    slot=f"styling.{lang}",
                    sources=[lang_source],
                    project_root=project_root,
                )
        elif isinstance(source, str):
            slot_to_paths[slot] = _resolve_mapped_source_paths(
                slot=slot,
                sources=[source],
                project_root=project_root,
            )
        elif isinstance(source, list):
            slot_to_paths[slot] = _resolve_mapped_source_paths(
                slot=slot,
                sources=source,
                project_root=project_root,
            )
    return slot_to_paths


# ── standards content resolution (for inline review prompts) ─────────────────

_LANGUAGE_EXTENSIONS: dict[str, str] = {
    ".py": "python",
    ".kt": "kotlin",
    ".kts": "kotlin",
    ".ts": "typescript",
    ".tsx": "typescript",
    ".sql": "sql",
}


@dataclass(frozen=True)
class _StandardsModuleSource:
    """One standards module to inline into a review prompt, tagged with the slot it fills."""
    slot_label: str
    source: str


def _resolve_skill_path(source: str) -> Path | None:
    """Resolve a 'skill:<name>' source to its SKILL.md path (repo-local then user-global)."""
    if not source.startswith("skill:"):
        return None
    skill_name = source[len("skill:"):]
    project_root = find_project_root()
    for base in (project_root / ".claude" / "skills", Path.home() / ".claude" / "skills"):
        candidate = base / skill_name / "SKILL.md"
        if candidate.exists():
            return candidate
    return None


def _resolve_standards_content_for_batch(batch_files: list[str], project_root: Path) -> str:
    """Read and concatenate the styling + testing standards modules relevant to the batch's languages."""
    manifest = _load_standards_manifest(project_root)

    # Determine which languages appear in this batch.
    languages_in_batch: set[str] = set()
    for file_path in batch_files:
        ext = Path(file_path).suffix
        lang = _LANGUAGE_EXTENSIONS.get(ext)
        if lang:
            languages_in_batch.add(lang)

    # Collect the module sources to read, in order: styling per language + common + testing + review lenses.
    module_sources: list[_StandardsModuleSource] = []
    styling_map = manifest.get(STYLING_SLOT, {})
    for lang in sorted(languages_in_batch):
        source = styling_map.get(lang) if isinstance(styling_map, dict) else None
        if source:
            module_sources.append(
                _StandardsModuleSource(slot_label=f"styling.{lang}", source=source),
            )
    for slot in ("common", "testing", REVIEW_SLOT_KEY):
        source = manifest.get(slot)
        if isinstance(source, str):
            module_sources.append(_StandardsModuleSource(slot_label=slot, source=source))
        elif isinstance(source, list):
            module_sources.extend(
                _StandardsModuleSource(slot_label=slot, source=listed_source)
                for listed_source in source
            )

    if not module_sources:
        return ""

    sections: list[str] = []
    for module_source in module_sources:
        module_path = _resolve_source_path(
            source=module_source.source,
            project_root=project_root,
        )
        if module_path:
            content = module_path.read_text().strip()
            sections.append(
                f"── {module_source.slot_label} ({module_source.source}) ──\n{content}"
            )

    if not sections:
        return ""

    return "\n\n".join(sections)


# ── markdown parsers ───────────────────────────────────────────────────────────

def parse_tasks(tasks_md: Path) -> list[dict]:
    if not tasks_md.exists():
        return []

    tasks: list[dict] = []
    current: dict | None = None

    for line in tasks_md.read_text().splitlines():
        header_match = TASK_HEADER_RE.match(line)
        if header_match:
            if current:
                tasks.append(current)
            current = {
                "tag": header_match.group(1),
                "action": header_match.group(2),
                "target": header_match.group(3),
                "status": TASK_STATUS_PENDING,
                "component_file": None,
                "blocked_by": [],
                "divergence": None,
                "raw_lines": [line],
            }
        elif current is not None:
            current["raw_lines"].append(line)
            stripped = line.strip()
            if stripped.startswith("Status:"):
                status_value = stripped.split(":", 1)[1].strip()
                if status_value in VALID_TASK_STATUSES:
                    current["status"] = status_value
            elif stripped.startswith("Component file:"):
                current["component_file"] = stripped.split(":", 1)[1].strip()
            elif stripped.startswith("Blocked by:"):
                blocked_text = stripped.split(":", 1)[1]
                current["blocked_by"].extend(BLOCKED_BY_TAG_RE.findall(blocked_text))
            elif stripped.startswith("Divergence:"):
                current["divergence"] = stripped.split(":", 1)[1].strip()

    if current:
        tasks.append(current)

    return tasks


@dataclass(frozen=True)
class Milestone:
    """One row of the `## Milestones` table — a named checkpoint over task groups and tags."""
    id: str
    title: str
    scope: tuple[str, ...]
    proves: str


def parse_milestones(tasks_md: Path) -> list[Milestone]:
    """Every row of the optional `## Milestones` table in tasks.md, in table order."""
    if not tasks_md.exists():
        return []
    section_match = MILESTONE_SECTION_RE.search(tasks_md.read_text())
    if not section_match:
        return []

    milestones: list[Milestone] = []
    for line in section_match.group(0).splitlines():
        row_match = MILESTONE_ROW_RE.match(line.strip())
        if not row_match:
            continue
        milestones.append(
            Milestone(
                id=row_match.group(1),
                title=row_match.group(2).strip(),
                scope=tuple(
                    token.strip()
                    for token in row_match.group(3).split(",")
                    if token.strip()
                ),
                proves=row_match.group(4).strip(),
            )
        )
    return milestones


def _render_milestone_table(milestones: list[Milestone]) -> str:
    """The `## Milestones` section as tasks.md holds it — the table and nothing else."""
    rows = [
        f"| {milestone.id} | {milestone.title} | {', '.join(milestone.scope)} | {milestone.proves} |"
        for milestone in milestones
    ]
    return "\n".join([MILESTONES_HEADING, "", MILESTONE_TABLE_HEADER, *rows])


def write_milestone_table(tasks_md: Path, milestones: list[Milestone]) -> None:
    """Replace the `## Milestones` section of tasks.md with these milestones."""
    content = tasks_md.read_text()
    section_match = MILESTONE_SECTION_RE.search(content)
    if section_match is None:
        _exit_error(f"no '{MILESTONES_HEADING}' table in {tasks_md} — nothing to rewrite")
    rewritten_section = f"{_render_milestone_table(milestones)}\n\n"
    tasks_md.write_text(
        content[: section_match.start()] + rewritten_section + content[section_match.end():]
    )


def _tag_to_milestone_claims(
    tasks: list[TaskRecord],
    milestones: list[Milestone],
) -> dict[str, list[tuple[str, str]]]:
    """Task tag → every (milestone id, claim kind) that names it, by group letter or by tag."""
    all_tags = [task["tag"] for task in tasks]
    tag_to_claims: dict[str, list[tuple[str, str]]] = {}
    for milestone in milestones:
        for token in milestone.scope:
            if MILESTONE_SCOPE_TAG_RE.match(token):
                if token in all_tags:
                    tag_to_claims.setdefault(token, []).append((milestone.id, MILESTONE_CLAIM_TAG))
                continue
            for tag in all_tags:
                if tag.startswith(f"{token}."):
                    tag_to_claims.setdefault(tag, []).append((milestone.id, MILESTONE_CLAIM_GROUP))
    return tag_to_claims


def _owning_milestone_ids(tag_to_claims: dict[str, list[tuple[str, str]]]) -> dict[str, str]:
    """Task tag → the milestone that owns it; an explicit tag beats a group letter."""
    tag_to_milestone_id: dict[str, str] = {}
    for tag, claims in tag_to_claims.items():
        explicit_ids = [claim_id for claim_id, kind in claims if kind == MILESTONE_CLAIM_TAG]
        group_ids = [claim_id for claim_id, kind in claims if kind == MILESTONE_CLAIM_GROUP]
        owning_ids = explicit_ids or group_ids
        tag_to_milestone_id[tag] = owning_ids[0]
    return tag_to_milestone_id


def _tag_to_milestone_id(
    tasks: list[TaskRecord],
    milestones: list[Milestone],
) -> dict[str, str]:
    """Task tag → the milestone that owns it."""
    return _owning_milestone_ids(
        tag_to_claims=_tag_to_milestone_claims(
            tasks=tasks,
            milestones=milestones,
        ),
    )


def _milestone_scope_findings(
    tasks: list[TaskRecord],
    milestones: list[Milestone],
    tag_to_milestone_id: dict[str, str],
) -> list[str]:
    """Scope cells that name nothing real, and milestones that end up claiming no task."""
    all_tags = [task["tag"] for task in tasks]
    findings: list[str] = []
    for milestone in milestones:
        for token in milestone.scope:
            if MILESTONE_SCOPE_TAG_RE.match(token):
                if token not in all_tags:
                    findings.append(
                        f"tasks.md — milestone {milestone.id} scope tag '{token}' matches no task"
                    )
            elif MILESTONE_SCOPE_GROUP_RE.match(token):
                if not any(tag.startswith(f"{token}.") for tag in all_tags):
                    findings.append(
                        f"tasks.md — milestone {milestone.id} scope group '{token}' matches no task"
                    )
            else:
                findings.append(
                    f"tasks.md — milestone {milestone.id} scope token '{token}' "
                    f"is neither a group letter nor a task tag"
                )
        if milestone.id not in tag_to_milestone_id.values():
            findings.append(f"tasks.md — milestone {milestone.id} claims no task")
    return findings


def _milestone_dependency_findings(
    tasks: list[TaskRecord],
    milestones: list[Milestone],
    tag_to_milestone_id: dict[str, str],
) -> list[str]:
    """Tasks blocked by a task that lands in a later milestone — that boundary could never drain."""
    milestone_order = {milestone.id: index for index, milestone in enumerate(milestones)}
    findings: list[str] = []
    for task in tasks:
        owning_id = tag_to_milestone_id.get(task["tag"])
        if owning_id is None:
            continue
        for blocker_tag in task["blocked_by"]:
            blocker_id = tag_to_milestone_id.get(blocker_tag)
            if blocker_id is None:
                continue
            if milestone_order[blocker_id] > milestone_order[owning_id]:
                findings.append(
                    f"tasks.md #{task['tag']} ({owning_id}) — Blocked by: '{blocker_tag}' "
                    f"lands in the later milestone {blocker_id}"
                )
    return findings


def _milestone_claim_findings(
    tasks: list[TaskRecord],
    tag_to_claims: dict[str, list[tuple[str, str]]],
    tag_to_milestone_id: dict[str, str],
) -> list[str]:
    """Tasks no milestone claims, and tasks two milestones claim with equal weight."""
    findings: list[str] = []
    for task in tasks:
        tag = task["tag"]
        if tag not in tag_to_milestone_id:
            findings.append(
                f"tasks.md #{tag} — no milestone claims this task; "
                f"every task must belong to exactly one"
            )
            continue

        claims = tag_to_claims[tag]
        explicit_ids = [claim_id for claim_id, kind in claims if kind == MILESTONE_CLAIM_TAG]
        competing_ids = explicit_ids or [claim_id for claim_id, _ in claims]
        if len(set(competing_ids)) > 1:
            findings.append(
                f"tasks.md #{tag} — claimed by more than one milestone "
                f"({', '.join(sorted(set(competing_ids)))})"
            )
    return findings


def _milestone_membership_findings(tasks: list[TaskRecord], milestones: list[Milestone]) -> list[str]:
    """Every way a Milestones table can fail to partition the task graph."""
    tag_to_claims = _tag_to_milestone_claims(tasks=tasks, milestones=milestones)
    tag_to_milestone_id = _owning_milestone_ids(tag_to_claims=tag_to_claims)
    return [
        *_milestone_scope_findings(
            tasks=tasks,
            milestones=milestones,
            tag_to_milestone_id=tag_to_milestone_id,
        ),
        *_milestone_claim_findings(
            tasks=tasks,
            tag_to_claims=tag_to_claims,
            tag_to_milestone_id=tag_to_milestone_id,
        ),
        *_milestone_dependency_findings(
            tasks=tasks,
            milestones=milestones,
            tag_to_milestone_id=tag_to_milestone_id,
        ),
    ]


def _milestone_id_sequence_findings(milestones: list[Milestone]) -> list[str]:
    """Ids must run M1, M2, … in table order — a gap makes the boundary order unreadable."""
    expected_ids = [f"M{index}" for index in range(1, len(milestones) + 1)]
    actual_ids = [milestone.id for milestone in milestones]
    if actual_ids == expected_ids:
        return []
    return [
        f"tasks.md — milestone ids must run {', '.join(expected_ids)} in table order "
        f"(found {', '.join(actual_ids)})"
    ]


def _milestone_table_findings(tasks: list[TaskRecord], milestones: list[Milestone]) -> list[str]:
    """Every rule a Milestones table must pass — id sequence plus a clean partition of the tasks."""
    return _milestone_id_sequence_findings(milestones) + _milestone_membership_findings(
        tasks=tasks,
        milestones=milestones,
    )


def parse_feature_acs(objective_md: Path) -> list[str]:
    if not objective_md.exists():
        return []
    text = objective_md.read_text()
    section_match = re.search(
        r"## (?:Functional ACs|Feature Change List).*?(?=^## |\Z)",
        text,
        re.MULTILINE | re.DOTALL,
    )
    if not section_match:
        return []
    return FEATURE_AC_RE.findall(section_match.group(0))


@dataclass(frozen=True)
class FeatureStrip:
    number: str
    title: str
    ac_tags: tuple[str, ...]


def parse_feature_strips(objective_md: Path) -> list[FeatureStrip]:
    """One strip per Phase-1 feature heading (number, title, its AC tags) for the roster skeleton."""
    if not objective_md.exists():
        return []
    section_match = re.search(
        r"## (?:Functional ACs|Feature Change List).*?(?=^## |\Z)",
        objective_md.read_text(),
        re.MULTILINE | re.DOTALL,
    )
    if not section_match:
        return []
    section_text = section_match.group(0)
    feature_headings = list(FEATURE_HEADING_RE.finditer(section_text))
    strips: list[FeatureStrip] = []
    for heading_index, heading in enumerate(feature_headings):
        body_start = heading.end()
        body_end = (
            feature_headings[heading_index + 1].start()
            if heading_index + 1 < len(feature_headings)
            else len(section_text)
        )
        ordered_unique_tags = tuple(
            dict.fromkeys(
                FEATURE_AC_RE.findall(section_text[body_start:body_end]),
            )
        )
        strips.append(
            FeatureStrip(
                number=heading.group(1),
                title=heading.group(2).strip(),
                ac_tags=ordered_unique_tags,
            ),
        )
    return strips


def parse_component_names(objective_md: Path) -> list[str]:
    # Component Summary lives in components/_overview.md; older bundles kept it in objective.md.
    overview_md = objective_md.parent / "components" / "_overview.md"
    for source in (overview_md, objective_md):
        if not source.exists():
            continue
        section_match = re.search(
            r"## Component Summary.*?(?=^## |\Z)",
            source.read_text(),
            re.MULTILINE | re.DOTALL,
        )
        if not section_match:
            continue
        table_names = re.findall(r"\|\s*\d+\.\d+\s*\|\s*(\w+)\s*\|", section_match.group(0))
        block_names = re.findall(r"^###\s+\d+\.\d+\s+(\w+)", section_match.group(0), re.MULTILINE)
        names = table_names + block_names
        if names:
            return names
    return []


def update_task_status_in_file(tasks_md: Path, tag: str, new_status: str) -> None:
    lines = tasks_md.read_text().splitlines(keepends=True)
    in_target_task = False
    updated = False
    result: list[str] = []

    for line in lines:
        stripped = line.rstrip()
        header_match = TASK_HEADER_RE.match(stripped)
        if header_match:
            in_target_task = header_match.group(1) == tag
        if in_target_task and re.match(r"^Status:\s*\w+", stripped) and not updated:
            result.append(f"Status: {new_status}\n")
            updated = True
        else:
            result.append(line)

    if not updated:
        _exit_error(f"Status: line not found for task '{tag}' in {tasks_md}")

    tasks_md.write_text("".join(result))

# ── helpers ────────────────────────────────────────────────────────────────────

def _exit_error(message: str) -> NoReturn:
    print(f"error: {message}", file=sys.stderr)
    sys.exit(1)


def _resolve_single_or_all(name: str | None) -> list[Path]:
    if name:
        return [resolve_schematic_dir(name)]
    dirs = list_schematic_dirs()
    if not dirs:
        _exit_error("no schematics found under docs/schematics/")
    return dirs

