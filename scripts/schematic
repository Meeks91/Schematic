MILESTONE_SECTION_RE = re.compile(rf"^{MILESTONES_HEADING}$.*?(?=^## |\Z)", re.MULTILINE | re.DOTALL)
MILESTONE_ROW_RE = re.compile(r"^\|\s*(M\d+)\s*\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|$")
MILESTONE_SCOPE_GROUP_RE = re.compile(r"^[a-z]$")
MILESTONE_SCOPE_TAG_RE = re.compile(r"^[a-z]\.\d+$")
RATIFICATION_PHRASE_RE = re.compile(
    r"awaiting ratification|open for ratification|needs (?:user )?sign|needs ratification",
    re.IGNORECASE,
)
